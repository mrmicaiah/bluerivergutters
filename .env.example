# RealWork Labs feed API key — used by scripts/fetch-rwl-data.mjs to pull the
# job feed into src/_data/projects.json. Not needed for `npm run build`.
#
#   RWL_KEY=<key> node scripts/fetch-rwl-data.mjs
#
# Ask the site owner for the current value. Never commit the real key —
# .env and .env.local are gitignored; this file is the template only.
RWL_KEY=
