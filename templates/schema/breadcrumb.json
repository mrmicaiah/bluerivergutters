{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bluerivergutters.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{BREADCRUMB_2_NAME}}",
      "item": "{{BREADCRUMB_2_URL}}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{BREADCRUMB_3_NAME}}",
      "item": "{{BREADCRUMB_3_URL}}"
    }
  ]
}

/*
 * BREADCRUMB EXAMPLES
 *
 * For city landing page (gutters-madison-al):
 * Position 2: "Locations" / "https://bluerivergutters.com/locations/"
 * Position 3: "Madison, AL" / "https://bluerivergutters.com/gutters-madison-al/"
 *
 * For service+city page (seamless-gutters-madison-al):
 * Position 2: "Madison, AL" / "https://bluerivergutters.com/gutters-madison-al/"
 * Position 3: "Seamless Gutters" / "https://bluerivergutters.com/seamless-gutters-madison-al/"
 *
 * For blog post:
 * Position 2: "Blog" / "https://bluerivergutters.com/blog/"
 * Position 3: "{{POST_TITLE}}" / "{{POST_URL}}"
 *
 * NOTES:
 * - Remove position 3 for pages that are only 2 levels deep
 * - The last item in the breadcrumb should NOT have an "item" URL
 *   (represents current page) - but Google tolerates it either way
 */