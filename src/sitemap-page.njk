---
layout: base.njk
title: Sitemap | Blue River Gutters
meta_description: Complete sitemap for Blue River Gutters. Find all our service pages, location pages, and blog articles.
permalink: /sitemap/
---

<section class="sitemap-hero">
  <div class="container">
    <h1>Sitemap</h1>
    <p>Find everything on our site organized by category.</p>
  </div>
</section>

<section class="sitemap-content">
  <div class="container">
    <div class="sitemap-grid">
      
      {# Main Pages #}
      <div class="sitemap-section">
        <h2>Main Pages</h2>
        <ul>
          <li><a href="{{ '/' | url }}">Home</a></li>
          <li><a href="{{ '/services/' | url }}">Services</a></li>
          <li><a href="{{ '/locations/' | url }}">Locations</a></li>
          <li><a href="{{ '/blog/' | url }}">Blog</a></li>
        </ul>
      </div>
      
      {# Services #}
      <div class="sitemap-section">
        <h2>Our Services</h2>
        <ul>
          {% for service in nav.services %}
          <li><a href="{{ ('/services/' + service.slug + '/') | url }}">{{ service.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
      
      {# Primary Markets (Tier 1) #}
      <div class="sitemap-section">
        <h2>Primary Markets</h2>
        <ul>
          {% for city in nav.locations.tier1 %}
          <li>
            <a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">Gutters {{ city.name }}, AL</a>
            <ul class="sitemap-sublist">
              {% for service in nav.services %}
              <li><a href="{{ ('/' + service.slug + '-' + city.slug + '-al/') | url }}">{{ service.name }} in {{ city.name }}</a></li>
              {% endfor %}
            </ul>
          </li>
          {% endfor %}
        </ul>
      </div>
      
      {# Regional Cities (Tier 2) #}
      <div class="sitemap-section">
        <h2>Regional Service Areas</h2>
        <ul>
          {% for city in nav.locations.tier2 %}
          <li>
            <a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">Gutters {{ city.name }}, AL</a>
            <ul class="sitemap-sublist">
              {% for service in nav.services %}
              <li><a href="{{ ('/' + service.slug + '-' + city.slug + '-al/') | url }}">{{ service.name }} in {{ city.name }}</a></li>
              {% endfor %}
            </ul>
          </li>
          {% endfor %}
        </ul>
      </div>
      
      {# Community Areas (Tier 3) #}
      <div class="sitemap-section">
        <h2>Communities We Serve</h2>
        <ul>
          {% for city in nav.locations.tier3 %}
          <li><a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">Gutters {{ city.name }}, AL</a></li>
          {% endfor %}
        </ul>
      </div>
      
      {# Blog Posts #}
      <div class="sitemap-section sitemap-section-full">
        <h2>Blog Articles</h2>
        {% if collections.blog.length > 0 %}
        <ul class="sitemap-blog-list">
          {% for post in collections.blog %}
          <li><a href="{{ post.url | url }}">{{ post.data.title }}</a></li>
          {% endfor %}
        </ul>
        {% else %}
        <p>Blog articles coming soon.</p>
        {% endif %}
      </div>
      
    </div>
  </div>
</section>

{# CTA Section #}
<section class="cta">
  <div class="container">
    <h2>Ready to Protect Your Home?</h2>
    <p>Schedule your free estimate today.</p>
    <a href="https://BlueRiverGutters.as.me/" class="btn btn-primary">Get Free Estimate</a>
    <div class="cta-phone">
      <a href="tel:2566166760">(256) 616-6760</a>
    </div>
  </div>
</section>
