permalink: /articles/
tags: []
---

{# Breadcrumbs #}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol class="breadcrumb-list">
      <li><a href="{{ '/' | url }}">Home</a></li>
      <li aria-current="page">Articles</li>
    </ol>
  </div>
</nav>

{# Page Header #}
<header class="page-header">
  <div class="container">
    <h1>Gutter Guides & Articles</h1>
    <p>In-depth guides, pricing info, and local expertise from 20+ years in North Alabama.</p>
  </div>
</header>

{# Articles List #}
<section class="articles-listing">
  <div class="container">
    
    {# Buyer's Guides & How-To Articles #}
    <div class="articles-section">
      <h2 class="section-title">Guides & Resources</h2>
      <div class="articles-grid">
        {% for article in collections.articles | reverse %}
          {% if article.data.category and article.data.category != "Local Guide" %}
          <a href="{{ article.url | url }}" class="article-card">
            <span class="article-category">{{ article.data.category }}</span>
            <h3>{{ article.data.headline | default(article.data.title) }}</h3>
            <p>{{ article.data.description | truncate(120) }}</p>
            <span class="article-meta">{{ article.data.read_time }} min read</span>
            <span class="article-link">Read Article →</span>
          </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    
    {# City Guides #}
    <div class="articles-section">
      <h2 class="section-title">Local City Guides</h2>
      <div class="articles-grid">
        {% for article in collections.articles %}
          {% if article.data.category == "Local Guide" %}
          <a href="{{ article.url | url }}" class="article-card article-card--city">
            <span class="article-category">{{ article.data.related_city | default("Local Guide") }}</span>
            <h3>{{ article.data.headline | default(article.data.title) }}</h3>
            <p>{{ article.data.description | truncate(120) }}</p>
            <span class="article-link">Read Guide →</span>
          </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    
  </div>
</section>

{# CTA #}
<section class="cta">
  <div class="container">
    <h2>Questions About Your Gutters?</h2>
    <p>We've been serving North Alabama for over 20 years. Give us a call for straight answers.</p>
    <a href="https://BlueRiverGutters.as.me/" class="btn btn-primary">Schedule Free Estimate</a>
    <p class="cta-phone"><a href="tel:2566166760">📞 (256) 616-6760</a></p>
  </div>
</section>

