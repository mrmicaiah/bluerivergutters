<!-- Lead form handler — Courier — with honeypot bot protection -->
<script>
(function() {
  const COURIER_API = 'https://email-bot-server.micaiah-tasks.workers.dev/api/subscribe';
  const COURIER_LIST = 'blue-river-gutters-leads';
  const FORM_LOAD_TIME = Date.now();

  const form = document.getElementById('lead-form');
  if (!form) return;

  const submitBtn = document.getElementById('lead-form-submit');
  const errorEl = document.getElementById('lead-form-error');

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.classList.add('active');
  }

  function clearError() {
    errorEl.classList.remove('active');
  }

  function fakeSuccess() {
    // Show success to bot so it doesn't try a different attack
    document.getElementById('form-view').style.display = 'none';
    document.getElementById('form-success').classList.add('active');
  }

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    clearError();

    // Honeypot check #1: hidden field must be empty
    const honeypot = document.getElementById('lead-website').value;
    if (honeypot) {
      console.warn('Honeypot triggered — silent reject');
      fakeSuccess();
      return;
    }

    // Honeypot check #2: form must take a human at least 3 seconds to fill
    const elapsed = Date.now() - FORM_LOAD_TIME;
    if (elapsed < 3000) {
      console.warn('Form filled too fast (' + elapsed + 'ms) — silent reject');
      fakeSuccess();
      return;
    }

    const name = document.getElementById('lead-name').value.trim();
    const phone = document.getElementById('lead-phone').value.trim();
    const email = document.getElementById('lead-email').value.trim();

    if (!name || !phone || !email) {
      showError('Please fill out all fields.');
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError('Please enter a valid email address.');
      return;
    }

    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    const payload = {
      email: email,
      name: name,
      list: COURIER_LIST,
      source: 'bluerivergutters.com',
      funnel: 'homepage-hero-form-v2',
      metadata: {
        phone: phone,
        service: 'not specified',
        page: 'homepage',
        time_to_fill_ms: elapsed
      }
    };

    try {
      const resp = await fetch(COURIER_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await resp.json().catch(() => ({}));

      if (resp.ok) {
        if (typeof gtag === 'function') {
          gtag('event', 'generate_lead', {
            event_category: 'engagement',
            event_label: 'homepage_hero_form',
            value: 1
          });
        }
        document.getElementById('form-view').style.display = 'none';
        document.getElementById('form-success').classList.add('active');
      } else {
        showError(data.error || 'Something went wrong. Please call us at (256) 616-6760.');
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    } catch (err) {
      console.error('Form submission error:', err);
      showError('Connection issue. Please call us at (256) 616-6760.');
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
})();
</script>
