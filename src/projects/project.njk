---
layout: base.njk
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/projects/{{ project.slug }}/"
---

{%- set title = project.title ~ " | Blue River Gutters" -%}
{%- set description = project.description -%}

{# Breadcrumbs #}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol class="breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a itemprop="item" href="{{ '/' | url }}">
          <span itemprop="name">Home</span>
        </a>
        <meta itemprop="position" content="1" />
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a itemprop="item" href="{{ '/recent-projects/' | url }}">
          <span itemprop="name">Projects</span>
        </a>
        <meta itemprop="position" content="2" />
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
        <span itemprop="name">{{ project.title }}</span>
        <meta itemprop="position" content="3" />
      </li>
    </ol>
  </div>
</nav>

{# Hero Section #}
<section class="hero hero-short" style="background-image: url('{{ project.images[0] | default(project.thumbnail) }}');">
  <div class="hero-overlay"></div>
  <div class="container hero-container">
    <div class="hero-content">
      <p class="hero-eyebrow">{{ project.service }} • {{ project.city }}</p>
      <h1>{{ project.title }}</h1>
      <p>{{ project.description }}</p>
    </div>
  </div>
</section>

{# Project Details #}
<section class="project-details">
  <div class="container">
    <div class="project-layout">
      
      {# Main Content #}
      <div class="project-main">
        <h2>Project Overview</h2>
        <p class="project-story">{{ project.details }}</p>
        
        {# Project Gallery #}
        {% if project.images.length > 0 %}
        <div class="project-gallery">
          <h3>Project Photos</h3>
          <div class="gallery-grid">
            {% for image in project.images %}
            <a href="{{ image }}" class="gallery-item" target="_blank">
              <img src="{{ image | replace('w_1200', 'w_600') }}" alt="{{ project.title }} - Photo {{ loop.index }}" loading="lazy">
            </a>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
      
      {# Sidebar #}
      <aside class="project-sidebar">
        
        {# Project Specs #}
        <div class="specs-card">
          <h3>Project Specifications</h3>
          <dl class="specs-list">
            <div class="spec-row">
              <dt>Location</dt>
              <dd>{{ project.city }}, AL</dd>
            </div>
            <div class="spec-row">
              <dt>Service</dt>
              <dd>{{ project.service }}</dd>
            </div>
            <div class="spec-row">
              <dt>Completed</dt>
              <dd>{{ project.date | date: "%B %Y" }}</dd>
            </div>
            {% if project.specs.gutterSize %}
            <div class="spec-row">
              <dt>Gutter Size</dt>
              <dd>{{ project.specs.gutterSize }}</dd>
            </div>
            {% endif %}
            {% if project.specs.material %}
            <div class="spec-row">
              <dt>Material</dt>
              <dd>{{ project.specs.material }}</dd>
            </div>
            {% endif %}
            {% if project.specs.color %}
            <div class="spec-row">
              <dt>Color</dt>
              <dd>{{ project.specs.color }}</dd>
            </div>
            {% endif %}
            {% if project.specs.linearFeet %}
            <div class="spec-row">
              <dt>Linear Feet</dt>
              <dd>{{ project.specs.linearFeet }}</dd>
            </div>
            {% endif %}
            {% if project.specs.downspouts %}
            <div class="spec-row">
              <dt>Downspouts</dt>
              <dd>{{ project.specs.downspouts }}</dd>
            </div>
            {% endif %}
            {% if project.specs.guardType %}
            <div class="spec-row">
              <dt>Guard Type</dt>
              <dd>{{ project.specs.guardType }}</dd>
            </div>
            {% endif %}
            {% if project.specs.warranty %}
            <div class="spec-row">
              <dt>Warranty</dt>
              <dd>{{ project.specs.warranty }}</dd>
            </div>
            {% endif %}
            {% if project.specs.pipeType %}
            <div class="spec-row">
              <dt>Pipe Type</dt>
              <dd>{{ project.specs.pipeType }}</dd>
            </div>
            {% endif %}
            {% if project.specs.totalLength %}
            <div class="spec-row">
              <dt>Total Length</dt>
              <dd>{{ project.specs.totalLength }}</dd>
            </div>
            {% endif %}
          </dl>
        </div>
        
        {# CTA Card #}
        <div class="sidebar-cta">
          <h3>Ready for Your Project?</h3>
          <p>Get a free estimate for your gutter needs.</p>
          <a href="https://BlueRiverGutters.as.me/" class="btn btn-primary">Schedule Estimate</a>
          <p class="sidebar-phone"><a href="tel:2566166760">📞 (256) 616-6760</a></p>
        </div>
        
      </aside>
    </div>
  </div>
</section>

{# Related Projects #}
<section class="related-projects">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">More Work</p>
      <h2>Related Projects</h2>
    </div>
    <div class="projects-grid">
      {% set relatedCount = 0 %}
      {% for p in projects %}
        {% if p.slug != project.slug and relatedCount < 3 %}
          {% if p.service == project.service or p.city == project.city %}
            {% set relatedCount = relatedCount + 1 %}
            <a href="{{ '/projects/' | url }}{{ p.slug }}/" class="project-card">
              <div class="project-card-image">
                <img src="{{ p.thumbnail }}" alt="{{ p.title }}" loading="lazy">
              </div>
              <div class="project-card-content">
                <span class="project-tag">{{ p.service }}</span>
                <h3>{{ p.title }}</h3>
                <p>{{ p.description }}</p>
                <span class="project-location">📍 {{ p.city }}, AL</span>
              </div>
            </a>
          {% endif %}
        {% endif %}
      {% endfor %}
      
      {# Fill remaining slots with featured projects #}
      {% if relatedCount < 3 %}
        {% for p in projects %}
          {% if p.slug != project.slug and p.featured and relatedCount < 3 %}
            {% set relatedCount = relatedCount + 1 %}
            <a href="{{ '/projects/' | url }}{{ p.slug }}/" class="project-card">
              <div class="project-card-image">
                <img src="{{ p.thumbnail }}" alt="{{ p.title }}" loading="lazy">
              </div>
              <div class="project-card-content">
                <span class="project-tag">{{ p.service }}</span>
                <h3>{{ p.title }}</h3>
                <p>{{ p.description }}</p>
                <span class="project-location">📍 {{ p.city }}, AL</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
    <div class="projects-all-link">
      <a href="{{ '/recent-projects/' | url }}" class="btn btn-dark">View All Projects</a>
    </div>
  </div>
</section>

{# CTA #}
<section class="cta" id="contact">
  <div class="container">
    <h2>Start Your Gutter Project</h2>
    <p>Get a free estimate for gutter installation, repair, or cleaning in {{ project.city }} and throughout North Alabama.</p>
    <a href="https://BlueRiverGutters.as.me/" class="btn btn-primary">Schedule Free Estimate</a>
    <p class="cta-phone"><a href="tel:2566166760">📞 (256) 616-6760</a></p>
    <p class="cta-hours">MON-FRI 8:00AM-5:00PM</p>
  </div>
</section>

{# Schema Markup #}
{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ project.title }}",
  "description": "{{ project.description }}",
  "image": "{{ project.images[0] | default(project.thumbnail) }}",
  "datePublished": "{{ project.date }}",
  "author": {
    "@type": "Organization",
    "name": "Blue River Gutters"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Blue River Gutters",
    "logo": {
      "@type": "ImageObject",
      "url": "https://res.cloudinary.com/dxzw1zwez/image/upload/logo-horizontal-white_kzwl0f.png"
    }
  }
}
</script>
{% endblock %}

<style>
.hero-short {
  min-height: 45vh;
  padding: 4rem 0;
}

.project-details {
  padding: 3rem 0 4rem;
}

.project-layout {
  display: grid;
  grid-template-columns: 1fr 350px;
  gap: 3rem;
  align-items: start;
}

.project-main h2 {
  margin-bottom: 1rem;
}

.project-story {
  font-size: 1.1rem;
  line-height: 1.8;
  color: var(--slate);
  margin-bottom: 2rem;
}

.project-gallery h3 {
  margin-bottom: 1rem;
  color: var(--navy);
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.gallery-item {
  border-radius: 8px;
  overflow: hidden;
  display: block;
}

.gallery-item img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  transition: transform 0.3s;
}

.gallery-item:hover img {
  transform: scale(1.05);
}

.project-sidebar {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.specs-card {
  background: var(--light-gray);
  border-radius: 12px;
  padding: 1.5rem;
}

.specs-card h3 {
  margin-bottom: 1rem;
  font-size: 1.1rem;
}

.specs-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.spec-row {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem 0;
  border-bottom: 1px solid rgba(0,0,0,0.06);
}

.spec-row:last-child {
  border-bottom: none;
}

.spec-row dt {
  color: var(--gray);
  font-size: 0.9rem;
}

.spec-row dd {
  color: var(--navy);
  font-weight: 600;
  font-size: 0.9rem;
}

.sidebar-cta {
  background: var(--navy);
  color: var(--white);
  border-radius: 12px;
  padding: 1.5rem;
  text-align: center;
}

.sidebar-cta h3 {
  color: var(--white);
  margin-bottom: 0.5rem;
}

.sidebar-cta p {
  color: rgba(255,255,255,0.8);
  margin-bottom: 1rem;
}

.sidebar-cta .btn {
  width: 100%;
  margin-bottom: 1rem;
}

.sidebar-phone a {
  color: var(--white);
  font-weight: 600;
}

.related-projects {
  background: var(--cream);
  padding: 4rem 0;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.project-card {
  background: var(--white);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  transition: transform 0.2s, box-shadow 0.2s;
  display: block;
  color: inherit;
}

.project-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 24px rgba(0,0,0,0.1);
}

.project-card-image img {
  width: 100%;
  height: 180px;
  object-fit: cover;
}

.project-card-content {
  padding: 1.25rem;
}

.project-tag {
  display: inline-block;
  background: var(--light-gray);
  color: var(--slate);
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.project-card h3 {
  font-size: 1rem;
  margin-bottom: 0.5rem;
  color: var(--navy);
}

.project-card p {
  font-size: 0.9rem;
  color: var(--gray);
  margin-bottom: 0.75rem;
  line-height: 1.5;
}

.project-location {
  font-size: 0.8rem;
  color: var(--gray);
}

.projects-all-link {
  text-align: center;
  margin-top: 2rem;
}

@media (max-width: 1024px) {
  .project-layout {
    grid-template-columns: 1fr;
  }
  
  .project-sidebar {
    flex-direction: row;
    flex-wrap: wrap;
  }
  
  .specs-card,
  .sidebar-cta {
    flex: 1;
    min-width: 280px;
  }
  
  .projects-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .gallery-grid {
    grid-template-columns: 1fr;
  }
  
  .project-sidebar {
    flex-direction: column;
  }
  
  .specs-card,
  .sidebar-cta {
    min-width: auto;
  }
  
  .projects-grid {
    grid-template-columns: 1fr;
  }
}
</style>
