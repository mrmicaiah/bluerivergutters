---
layout: base.njk
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/projects/{{ project.slug }}/"
eleventyComputed:
  title: "{{ project.title }} | Blue River Gutters"
  description: "{{ project.description | truncate(155) }}"
---

{# Breadcrumb #}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol class="breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a itemprop="item" href="{{ '/' | url }}"><span itemprop="name">Home</span></a>
        <meta itemprop="position" content="1" />
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a itemprop="item" href="{{ '/recent-projects/' | url }}"><span itemprop="name">Projects</span></a>
        <meta itemprop="position" content="2" />
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
        <span itemprop="name">{{ project.title }}</span>
        <meta itemprop="position" content="3" />
      </li>
    </ol>
  </div>
</nav>

{# Hero with project hero image #}
<section class="project-hero" style="background-image: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('{{ project.heroImage | default(project.thumbnail) }}');">
  <div class="container">
    <div class="project-hero-content">
      <p class="project-hero-eyebrow">{{ project.service }} &nbsp;·&nbsp; {{ project.city }}, AL</p>
      <h1>{{ project.title }}</h1>
      <p class="project-hero-meta">Completed {{ project.date | dateFormat("MMMM YYYY") }}</p>
    </div>
  </div>
</section>

{# Main content #}
<section class="project-details">
  <div class="container">
    <div class="project-layout">
      <div class="project-main">

        {# Description #}
        <h2>About This Project</h2>
        <p class="project-story">{{ project.description }}</p>

        {# Photo gallery — only render if real photos exist #}
        {% if project.hasPhotos and project.images.length > 0 %}
        <div class="project-gallery">
          <h3>Project Photos</h3>
          <div class="gallery-grid">
            {% for image in project.images %}
            <a href="{{ image }}" class="gallery-item" target="_blank" rel="noopener">
              <img src="{{ image }}" alt="{{ project.title }} — Photo {{ loop.index }}" loading="lazy">
            </a>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {# Customer review — only render if exists #}
        {% if project.hasReview and project.review %}
        <div class="project-review">
          <h3>What the Customer Said</h3>
          <blockquote class="review-card">
            <div class="review-stars" aria-label="{{ project.review.rating }} out of 5 stars">
              {% for i in range(0, project.review.rating) %}★{% endfor %}
            </div>
            <p class="review-text">{{ project.review.text }}</p>
            <footer class="review-footer">
              <cite>— {{ project.review.author }}, {{ project.city }}</cite>
              {% if project.review.source %}<span class="review-source">via {{ project.review.source }}</span>{% endif %}
            </footer>
          </blockquote>
        </div>
        {% endif %}

      </div>

      {# Sidebar #}
      <aside class="project-sidebar">
        <div class="specs-card">
          <h3>Project Details</h3>
          <dl class="specs-list">
            <div class="spec-row"><dt>Service</dt><dd>{{ project.service }}</dd></div>
            <div class="spec-row"><dt>Location</dt><dd>{{ project.city }}, AL</dd></div>
            {% if project.zip %}<div class="spec-row"><dt>Zip Code</dt><dd>{{ project.zip }}</dd></div>{% endif %}
            <div class="spec-row"><dt>Completed</dt><dd>{{ project.date | dateFormat("MMMM YYYY") }}</dd></div>
            {% if project.review %}<div class="spec-row"><dt>Customer Rating</dt><dd>{{ project.review.rating }}/5 ★</dd></div>{% endif %}
          </dl>

          {% if project.cityHasPage %}
          <a href="{{ ('/gutters-' + project.citySlug + '-al/') | url }}" class="city-link">
            More gutter work in {{ project.city }} →
          </a>
          {% endif %}
        </div>

        <div class="sidebar-cta">
          <h3>Need Similar Work Done?</h3>
          <p>Free estimates for gutter installation, repair, and cleaning in {{ project.city }} and across North Alabama.</p>
          <a href="https://BlueRiverGutters.as.me/" class="btn btn-primary">Schedule Free Estimate</a>
          <p class="sidebar-phone"><a href="tel:2566166760">📞 (256) 616-6760</a></p>
        </div>
      </aside>
    </div>
  </div>
</section>

{# Related projects: same service or same city, max 3 #}
<section class="related-projects">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">More Work</p>
      <h2>Related Projects</h2>
    </div>
    <div class="related-grid">
      {%- set relatedCount = 0 -%}
      {%- for p in projects -%}
        {%- if p.slug != project.slug and relatedCount < 3 and (p.service == project.service or p.city == project.city) -%}
          {%- set relatedCount = relatedCount + 1 -%}
          <a href="{{ ('/projects/' + p.slug + '/') | url }}" class="related-card">
            <div class="related-card-image"><img src="{{ p.thumbnail }}" alt="{{ p.title }}" loading="lazy"></div>
            <div class="related-card-content">
              <span class="related-tag">{{ p.service }}</span>
              <h3>{{ p.title }}</h3>
              <span class="related-location">📍 {{ p.city }}, AL</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="projects-all-link">
      <a href="{{ '/recent-projects/' | url }}" class="btn btn-dark">View All Projects</a>
    </div>
  </div>
</section>

{# Final CTA #}
<section class="cta">
  <div class="container">
    <h2>Start Your Gutter Project</h2>
    <p>Get a free estimate for gutter installation, repair, or cleaning in {{ project.city }} and throughout North Alabama.</p>
    <a href="https://BlueRiverGutters.as.me/" class="btn btn-primary">Schedule Free Estimate</a>
    <p class="cta-phone"><a href="tel:2566166760">📞 (256) 616-6760</a></p>
    <p class="cta-hours">MON-FRI 8:00AM-5:00PM</p>
  </div>
</section>

{# Schema markup — Article + Place #}
{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ project.title | dump | safe }},
  "description": {{ project.description | dump | safe }},
  "image": {{ (project.heroImage | default(project.thumbnail)) | dump | safe }},
  "datePublished": "{{ project.date }}",
  "author": {"@type": "Organization", "name": "Blue River Gutters"},
  "publisher": {
    "@type": "Organization",
    "name": "Blue River Gutters",
    "logo": {"@type": "ImageObject", "url": "https://res.cloudinary.com/dxzw1zwez/image/upload/logo-horizontal-white_kzwl0f.png"}
  },
  "contentLocation": {
    "@type": "Place",
    "name": "{{ project.city }}, Alabama"{% if project.geolocation %},
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ project.geolocation.lat }},
      "longitude": {{ project.geolocation.lng }}
    }{% endif %}
  }
}
</script>
{% if project.hasReview and project.review %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "LocalBusiness",
    "name": "Blue River Gutters",
    "telephone": "(256) 616-6760",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "3315 Memorial Pkwy SW Suite B13",
      "addressLocality": "Huntsville",
      "addressRegion": "AL",
      "postalCode": "35801"
    }
  },
  "reviewRating": {"@type": "Rating", "ratingValue": "{{ project.review.rating }}", "bestRating": "5"},
  "author": {"@type": "Person", "name": "{{ project.review.author }}"},
  "reviewBody": {{ project.review.text | dump | safe }}
}
</script>
{% endif %}
{% endblock %}

<style>
/* === Project Hero === */
.project-hero {
  background-size: cover;
  background-position: center;
  color: var(--white);
  padding: 5rem 0 4rem;
  min-height: 320px;
  display: flex;
  align-items: center;
}
.project-hero-content { max-width: 800px; }
.project-hero-eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  opacity: 0.95;
}
.project-hero h1 {
  color: var(--white);
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  margin: 0 0 0.75rem;
  line-height: 1.15;
}
.project-hero-meta {
  font-size: 0.95rem;
  opacity: 0.9;
  margin: 0;
}

/* === Layout === */
.project-details { padding: 3rem 0 4rem; background: var(--cream); }
.project-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: 3rem;
  align-items: start;
}
.project-main h2 { margin-bottom: 1rem; color: var(--navy); }
.project-story {
  font-size: 1.1rem;
  line-height: 1.75;
  color: var(--slate);
  margin-bottom: 2.5rem;
}

/* === Gallery === */
.project-gallery { margin-bottom: 2.5rem; }
.project-gallery h3 { margin-bottom: 1rem; color: var(--navy); }
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 0.75rem;
}
.gallery-item {
  border-radius: 8px;
  overflow: hidden;
  display: block;
  background: var(--light-gray);
  aspect-ratio: 4/3;
}
.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s;
  display: block;
}
.gallery-item:hover img { transform: scale(1.05); }

/* === Review === */
.project-review { margin-bottom: 2rem; }
.project-review h3 { margin-bottom: 1rem; color: var(--navy); }
.review-card {
  background: var(--white);
  border-left: 4px solid var(--blue);
  padding: 1.5rem 1.75rem;
  border-radius: 8px;
  margin: 0;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.review-stars {
  color: #f5b400;
  font-size: 1.25rem;
  letter-spacing: 0.1em;
  margin-bottom: 0.75rem;
}
.review-text {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--slate);
  font-style: italic;
  margin: 0 0 1rem;
}
.review-footer {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
  font-size: 0.9rem;
}
.review-footer cite {
  color: var(--navy);
  font-style: normal;
  font-weight: 600;
}
.review-source {
  color: var(--gray);
  font-size: 0.85rem;
}

/* === Sidebar === */
.project-sidebar {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  position: sticky;
  top: 100px;
}
.specs-card {
  background: var(--white);
  border-radius: 12px;
  padding: 1.5rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.specs-card h3 { margin-bottom: 1rem; font-size: 1.1rem; color: var(--navy); }
.specs-list {
  display: flex;
  flex-direction: column;
  margin-bottom: 1rem;
}
.spec-row {
  display: flex;
  justify-content: space-between;
  padding: 0.6rem 0;
  border-bottom: 1px solid var(--light-gray);
  margin: 0;
}
.spec-row:last-child { border-bottom: none; }
.spec-row dt { color: var(--gray); font-size: 0.9rem; }
.spec-row dd {
  color: var(--navy);
  font-weight: 600;
  font-size: 0.9rem;
  margin: 0;
  text-align: right;
}
.city-link {
  display: block;
  margin-top: 0.5rem;
  color: var(--blue);
  font-weight: 600;
  font-size: 0.95rem;
  text-decoration: none;
}
.city-link:hover { text-decoration: underline; }

.sidebar-cta {
  background: var(--navy);
  color: var(--white);
  border-radius: 12px;
  padding: 1.75rem 1.5rem;
  text-align: center;
}
.sidebar-cta h3 { color: var(--white); margin-bottom: 0.5rem; }
.sidebar-cta p { color: rgba(255,255,255,0.85); margin-bottom: 1.25rem; font-size: 0.95rem; }
.sidebar-cta .btn { width: 100%; margin-bottom: 1rem; }
.sidebar-phone a { color: var(--white); font-weight: 600; }

/* === Related === */
.related-projects { background: var(--white); padding: 4rem 0; }
.related-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-bottom: 2rem;
}
.related-card {
  background: var(--cream);
  border-radius: 12px;
  overflow: hidden;
  display: block;
  color: inherit;
  text-decoration: none;
  transition: transform 0.2s, box-shadow 0.2s;
}
.related-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 24px rgba(0,0,0,0.1);
}
.related-card-image {
  aspect-ratio: 4/3;
  background: var(--light-gray);
  overflow: hidden;
}
.related-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.related-card-content { padding: 1.25rem; }
.related-tag {
  display: inline-block;
  background: var(--white);
  color: var(--slate);
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}
.related-card h3 {
  font-size: 1rem;
  margin: 0.25rem 0 0.5rem;
  color: var(--navy);
  line-height: 1.3;
}
.related-location {
  font-size: 0.85rem;
  color: var(--gray);
}
.projects-all-link { text-align: center; }

/* === Responsive === */
@media (max-width: 1024px) {
  .project-layout { grid-template-columns: 1fr; }
  .project-sidebar { position: static; }
  .related-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .project-hero { padding: 3.5rem 0 2.5rem; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .related-grid { grid-template-columns: 1fr; }
}
</style>
