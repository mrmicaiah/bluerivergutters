{# #live-float, desktop only: a floating booking pill while no booking row,
   form or closing block is on screen, so every scroll position offers a way
   to book (phones have the site's sticky Call / Free Estimate bar). Fixed +
   opacity/transform only: it can never shift the page. #}
<script>
  (function () {
    var f = document.getElementById('live-float');
    if (!f || !('IntersectionObserver' in window)) return;
    var spots = document.querySelectorAll('.live-intro .live-book, #quick-form form, #quick-form-2 form, .live-close .live-book'), on = {};
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { on[[].indexOf.call(spots, e.target)] = e.isIntersecting; });
      var show = !Object.keys(on).some(function (k) { return on[k]; });
      f.classList.toggle('is-on', show);
      if (show) { f.removeAttribute('aria-hidden'); f.removeAttribute('tabindex'); }
      else { f.setAttribute('aria-hidden', 'true'); f.setAttribute('tabindex', '-1'); }
    }, { rootMargin: '-60px 0px -60px 0px' }); // a sliver at the screen edge doesn't count
    function go() { [].forEach.call(spots, function (el) { io.observe(el); }); }
    // Not needed until someone scrolls: keep it out of the first render.
    if (document.readyState === 'complete') go(); else addEventListener('load', go);
  })();
</script>

{# Words. window.brgStream holds the page's language, pure functions of real
   feed data (tests call them directly):
   - headline(post, now, k): the big red line, present tense, by AGE TIER —
       fresh  (< 1h)        "Fresh off the ladder in Decatur" / "Minutes ago in …" / "Just in from …"
       today  (same day)    "Today in …" / "This afternoon in …" (the real part of day) / "Earlier today in …"
       yesterday            "Yesterday in …" / "Yesterday afternoon in …"
       week   (2–6 days)    "Thursday in …"
       older                "Nov 2 in …"
     k picks the variant; the stream passes how many posts of that tier came
     before, so neighbours never repeat. Never "right now", never invented
     activity: the exact time is always the quiet sub-line under it.
   - hook(post, k): the crew-voiced line after a post, keyed to that post's
     town and words in its comment (clean / guard / seamless / downspout /
     wood); generic when nothing matches. No prices, no counts.
   - stats(posts, now): a sentence with life ("The crew's been in Decatur
     today"), or "" when it would sound thin.
   America/Chicago days throughout (computed, no Intl time-zone formatter). #}
<script>
  (function () {
    var HOUR = 3600000, DAY = 86400000;
    var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    var WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    // America/Chicago wall time by arithmetic (US rules: CDT from the 2nd
    // Sunday of March 2am to the 1st Sunday of November 2am, else CST). A
    // time-zone Intl formatter costs ~70ms to build on a slow phone, right in
    // the first render; this costs nothing. The tests check it against Intl.
    function sunday(y, m, from) { var d = new Date(Date.UTC(y, m, from)).getUTCDay(); return from + (7 - d) % 7; }
    function local(t) {
      var ms = typeof t === 'number' ? t : Date.parse(t), y = new Date(ms).getUTCFullYear();
      var cdt = ms >= Date.UTC(y, 2, sunday(y, 2, 8), 8) && ms < Date.UTC(y, 10, sunday(y, 10, 1), 7);
      return new Date(ms - (cdt ? 5 : 6) * HOUR);
    }
    function parts(t) {
      var d = local(t), y = d.getUTCFullYear(), m = d.getUTCMonth(), dd = d.getUTCDate();
      return { n: Date.UTC(y, m, dd) / DAY, hour: d.getUTCHours(), y: y, m: m, d: dd, wd: d.getUTCDay(), key: y + '-' + (m + 1) + '-' + dd };
    }
    function daysAgo(t, now) { return parts(now).n - parts(t).n; }
    function partOfDay(t) { var h = parts(t).hour; return h < 12 ? 'morning' : h < 17 ? 'afternoon' : 'evening'; }
    function weekday(t) { return WEEKDAYS[parts(t).wd]; }
    function date(t, now) {
      var p = parts(t);
      return MONTHS[p.m] + ' ' + p.d + (p.y !== parts(now == null ? Date.now() : now).y ? ', ' + p.y : '');
    }
    function tier(t, now) {
      now = now == null ? Date.now() : now;
      var age = now - Date.parse(t), d = daysAgo(t, now);
      if (age < HOUR && d <= 0) return 'fresh';
      if (d <= 0) return 'today';
      if (d === 1) return 'yesterday';
      if (d < 7) return 'week';
      return 'older';
    }
    function at(town) { return town ? ' in ' + town : ''; }
    function headline(p, now, k) {
      now = now == null ? Date.now() : now; k = k || 0;
      var t = p.posted_at, town = (p.town || '').trim(), tr = tier(t, now), v;
      if (tr === 'fresh') v = [
        'Fresh off the ladder' + at(town),
        'Minutes ago' + at(town),
        town ? 'Just in from ' + town : 'Just in from the field'];
      else if (tr === 'today') v = [
        'Today' + at(town),
        'This ' + partOfDay(t) + at(town),
        'Earlier today' + at(town)];
      else if (tr === 'yesterday') v = [
        'Yesterday' + at(town),
        'Yesterday ' + partOfDay(t) + at(town)];
      else if (tr === 'week') v = [weekday(t) + at(town)];
      else v = [date(t, now) + at(town)];
      return v[k % v.length];
    }

    // Crew-voiced lines keyed to the post above. Only what the post says.
    var KINDS = [
      ['clean', /clean|clog|debris|leaves|pine|gunk|flush|full/i, [
        'Gutters like these fill up fast around here. Yours could be next on the list — ',
        'That’s what a clean-out looks like. Want your gutters flowing again? ']],
      ['guard', /guard|screen|cover|leaf ?filter/i, [
        'Guards on and done. Tired of climbing a ladder every fall? We’ll look at yours — ',
        'One less fall chore for that homeowner. Want guards priced for your roof? ']],
      ['seamless', /seamless|new gutter|install|6.?inch|5.?inch|k-style|run/i, [
        'Fresh seamless run, measured and formed on site. Want yours measured? ',
        'New gutters, no seams to leak. Free inspection for yours — ']],
      ['drain', /downspout|drain|underground|french|splash|pooling|foundation/i, [
        'Water headed where it belongs. Pooling by your foundation? We’ll take a look — ',
        'Downspouts sorted. If water’s sitting by your house, let’s fix that — ']],
      ['wood', /wood|fascia|rot|soffit|trim/i, [
        'Rotten fascia doesn’t fix itself. We’ll check yours on the same visit — ']]
    ];
    function hook(p, k) {
      k = k || 0;
      var c = p.comment || '', town = (p.town || '').trim();
      for (var i = 0; i < KINDS.length; i++) if (KINDS[i][1].test(c)) return { kind: KINDS[i][0], text: KINDS[i][2][k % KINDS[i][2].length] };
      if (town) {
        var v = [
          'That’s a ' + town + ' roofline. Yours could be next — we’re booking this week. ',
          'Another one done in ' + town + '. Free estimates this week — ',
          'Live near ' + town + '? The crew’s already in the neighborhood. '];
        return { kind: 'town', text: v[k % v.length] };
      }
      return { kind: 'generic', text: 'This could be your house — free estimates across Huntsville & North Alabama. ' };
    }

    // A sentence with life, or nothing. Today first (towns by most posts,
    // newest first on ties); else a strong week; else blank.
    function stats(posts, now) {
      now = now == null ? Date.now() : now;
      function towns(list) {
        var seen = {}, out = [];
        list.forEach(function (p) {
          var t = (p.town || '').trim(), k = t.toLowerCase();
          if (!t) return;
          if (!seen[k]) { seen[k] = { name: t, n: 0, i: out.length }; out.push(seen[k]); }
          seen[k].n++;
        });
        return out.sort(function (a, b) { return b.n - a.n || a.i - b.i; }).map(function (x) { return x.name; });
      }
      var today = posts.filter(function (p) { return daysAgo(p.posted_at, now) <= 0; }), tt = towns(today);
      if (tt.length === 1) return 'The crew’s been in ' + tt[0] + ' today';
      if (tt.length === 2) return 'The crew’s been in ' + tt[0] + ' and ' + tt[1] + ' today';
      if (tt.length > 2) return 'The crew’s been in ' + tt[0] + ', ' + tt[1] + ' and ' + (tt.length - 2) + ' more town' + (tt.length - 2 === 1 ? '' : 's') + ' today';
      var week = posts.filter(function (p) { return now - Date.parse(p.posted_at) < 7 * DAY; }), wt = towns(week);
      var photos = week.reduce(function (a, p) { return a + Math.max(+p.count || 0, Array.isArray(p.photos) ? p.photos.length : 1); }, 0);
      if (photos >= 10 && wt.length >= 3) return 'This week the crew’s been in ' + wt[0] + ', ' + wt[1] + ' and ' + (wt.length - 2) + ' more town' + (wt.length - 2 === 1 ? '' : 's');
      return '';
    }
    function dayLabel(t, now) {
      now = now == null ? Date.now() : now;
      var d = daysAgo(t, now);
      return d <= 0 ? 'Today' : d === 1 ? 'Yesterday' : d < 7 ? weekday(t) : date(t, now);
    }
    // Same words as brgLive.rel() (the 15s ticker rewrites with that), without
    // its time-zone formatter for posts over a week old.
    function ago(t, now) {
      now = now == null ? Date.now() : now;
      var m = Math.floor(Math.max(0, now - Date.parse(t)) / 60000), h = Math.floor(m / 60), d = Math.floor(h / 24);
      return m < 1 ? 'just now' : m < 60 ? m + ' min ago' : h < 24 ? h + (h === 1 ? ' hr' : ' hrs') + ' ago' : d < 7 ? d + (d === 1 ? ' day' : ' days') + ' ago' : date(t, now);
    }
    window.brgStream = { tier: tier, headline: headline, hook: hook, stats: stats, dayLabel: dayLabel, date: date, ago: ago, dayKey: function (t) { return parts(t).key; } };
  })();
</script>

{# Feed: GET /api/live/feed?cursor -> {posts:[{id, photos:[{id,w,h,thumb,full}],
   count, town, taken_at|null, posted_at, comment|null}], next}. The pre-batch
   shape (w,h,thumb,full on the post) still renders as a one-photo post.
   Everything from the feed goes in as text or a checked https URL, never as
   HTML. Town only: no coordinates, in the posts or the JSON-LD.
   Stream order: a day node opens each day's run (and the part below the
   form again); posts 1..K, then the form card, then the rest; a
   crew-voiced hook follows post n when n % 4 == 0 — never next to a form,
   never trailing the stream. Posts further down slide in as they enter the
   screen (transform/opacity only; none under reduced motion). #}
<script>
  (function () {
    function get(cursor) {
      return fetch('/api/live/feed' + (cursor ? '?cursor=' + encodeURIComponent(cursor) : ''), { headers: { accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
    }
    if (!window.brgLiveFirst) { window.brgLiveFirst = get(null); window.brgLiveFirst.catch(function () {}); }
    if (window.brgTrack) brgTrack('live_page_view');

    var HOOK_EVERY = 4, FILM_MAX = 16, FORM2_AFTER = 6, BOOK = 'https://BlueRiverGutters.as.me/';
    function start() {
      var L = window.brgLive, W = window.brgStream,
          first = document.getElementById('live-stream'), rest = document.getElementById('live-stream-more'),
          status = document.getElementById('live-status'), statsEl = document.getElementById('live-stats'),
          film = document.getElementById('live-film'), empty = document.getElementById('live-empty'),
          more = document.getElementById('live-more'), form2 = document.getElementById('quick-form-2'),
          intro = document.getElementById('live-intro'), mosaic = document.getElementById('live-mosaic'),
          pols = document.getElementById('live-polaroids'), ticker = document.getElementById('live-ticker-track'),
          shown = [], seen = {}, next = null, busy = false, count = 0, lastDay = null, hooks = 0, reveal = null;
      var K = matchMedia('(max-width: 768px)').matches ? 2 : 3;

      // Posts further down hang onto the rail as they scroll into view.
      if (!L.reduced && 'IntersectionObserver' in window) {
        reveal = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.remove('is-pending'); reveal.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
      }

      // Photos and videos both: a video entry ({kind:"video", duration, mp4,
      // poster, thumb}) shows as its poster jpg everywhere, and only a stream
      // card ever plays it (see strip()).
      function photos(p) {
        var ph = Array.isArray(p.photos) ? p.photos : [{ id: p.id, w: p.w, h: p.h, thumb: p.thumb, full: p.full }];
        return ph.filter(function (x) { return x && L.still(x); });
      }
      function vthumb(img, cls) {
        var w = L.el('span', cls);
        w.appendChild(img);
        w.appendChild(L.glyph());
        return w;
      }

      // Inline playback: a tap lays a <video> over the poster in the slide's
      // reserved box — muted, playsinline, no autoplay, native controls once
      // it plays (for sound) — and nothing loads before that tap. One plays
      // at a time; one scrolled or swiped out of sight pauses.
      var seenV = 'IntersectionObserver' in window ? new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (!e.isIntersecting && !e.target.paused) e.target.pause(); });
      }, { threshold: 0.2 }) : null;
      document.addEventListener('play', function (e) {
        var vs = document.querySelectorAll('video.live-video');
        for (var i = 0; i < vs.length; i++) if (vs[i] !== e.target && !vs[i].paused) vs[i].pause();
      }, true);
      function playIn(slide, x, img, btn, chip) {
        var v = L.el('video', 'live-video');
        v.muted = true; v.defaultMuted = true; v.setAttribute('muted', '');
        v.playsInline = true; v.setAttribute('playsinline', ''); v.setAttribute('webkit-playsinline', '');
        v.preload = 'none';
        v.poster = img.currentSrc || img.src;
        v.controls = true;
        v.setAttribute('aria-label', img.alt);
        v.src = L.safe(x.mp4);
        slide.appendChild(v);
        btn.hidden = true; chip.hidden = true;
        if (seenV) seenV.observe(v);
        var pr = v.play();
        if (pr && pr.catch) pr.catch(function () { /* controls are there to start it by hand */ });
        try { v.focus({ preventScroll: true }); } catch (err) {}
        if (window.brgTrack) brgTrack('live_video_play');
      }
      function ratio(x) { var w = Math.round(+x.w) || 4, h = Math.round(+x.h) || 3; return { w: w, h: h }; }
      // The feed thumb is w_500; stream cards are ~530px (zigzag) to ~680px
      // wide on bigger screens, so offer a w_1000 too. Phones are told "170px" so they keep the w_500
      // they always had (same quality and bytes as before, LCP unchanged).
      function big(u) { return L.small(u).replace('/w_200,', '/c_limit,w_1000,'); }

      function strip(p, ph, lcp) {
        var s = L.el('div', 'live-strip'), r0 = ratio(ph[0]);
        s.style.aspectRatio = String(Math.min(4 / 3, Math.max(3 / 4, r0.w / r0.h)));
        ph.forEach(function (x, i) {
          // A playable video is a box (not a link) holding the poster, a
          // full-box play button and its duration; a photo links to the full size.
          var vid = L.isVideo(x), d = vid ? L.dur(x.duration) : '';
          var r = ratio(x), a = L.el(vid ? 'div' : 'a', 'live-slide' + (vid ? ' is-video' : '')), img = L.el('img'), src = L.still(x);
          if (!vid) {
            a.href = L.safe(x.full) || src;
            a.target = '_blank'; a.rel = 'noopener';
          }
          a.style.aspectRatio = r.w + ' / ' + r.h;
          img.width = r.w; img.height = r.h;
          if (lcp && !i) { img.loading = 'eager'; img.fetchPriority = 'high'; }
          else { img.loading = 'lazy'; img.decoding = 'async'; }
          img.alt = (p.comment ? p.comment : 'Gutter job' + (p.town ? ' in ' + p.town : '')) +
            (vid ? ' (video' + (d ? ', ' + d : '') + (ph.length > 1 ? ', ' + (i + 1) + ' of ' + ph.length : '') + ')' : ph.length > 1 ? ' (photo ' + (i + 1) + ' of ' + ph.length + ')' : '');
          if (vid) {
            var btn = L.el('button', 'live-play'), chip = L.el('span', 'live-dur', d);
            btn.type = 'button';
            btn.setAttribute('aria-label', 'Play video' + (d ? ' (' + d + ')' : ''));
            btn.appendChild(L.glyph());
            chip.hidden = !d;
            btn.addEventListener('click', function () { playIn(a, x, img, btn, chip); });
          }
          if (/res\.cloudinary\.com/.test(src)) {
            img.srcset = src + ' 500w, ' + big(src) + ' 1000w';
            img.sizes = '(max-width: 768px) 170px, (min-width: 1024px) 530px, 680px';
          }
          img.src = src;
          a.appendChild(img);
          if (vid) { a.appendChild(btn); a.appendChild(chip); }
          s.appendChild(a);
        });
        return s;
      }

      var tierSeen = {};
      function post(p) {
        var ph = photos(p), total = Math.max(+p.count || 0, ph.length);
        var c = L.el('li', 'ls-post'), node = L.el('span', 'ls-node'), card = L.el('article', 'ls-card'),
            media = L.el('div', 'live-media'), s = strip(p, ph, shown.length === 1);
        c.id = 'ls-' + count;
        // Desktop zigzag: posts alternate sides of a centred rail (CSS, >=1024px).
        c.classList.add(count % 2 ? 'is-left' : 'is-right');
        c.setAttribute('data-id', p.id);
        node.setAttribute('aria-hidden', 'true');
        c.appendChild(node);
        media.appendChild(s);
        if (total > 1) {
          // "+2 photos", "+1 video", or "+2 more" when the rest are mixed.
          var restV = ph.slice(1).filter(function (x) { return x.kind === 'video'; }).length, m = total - 1;
          var what = !restV ? 'photo' + (m === 1 ? '' : 's') : restV === ph.length - 1 && ph.length === total ? 'video' + (m === 1 ? '' : 's') : 'more';
          var n = L.el('button', 'live-count', '+' + m + ' ' + what);
          n.type = 'button';
          n.setAttribute('aria-label', 'Next ' + (restV ? 'item' : 'photo') + ' (' + total + ' in this post)');
          n.addEventListener('click', function () {
            var atEnd = s.scrollLeft + s.clientWidth >= s.scrollWidth - 4;
            s.scrollTo({ left: atEnd ? 0 : s.scrollLeft + s.clientWidth * 0.9, behavior: L.reduced ? 'auto' : 'smooth' });
          });
          var raf = 0;
          s.addEventListener('scroll', function () {
            if (raf) return;
            raf = requestAnimationFrame(function () {
              raf = 0;
              var k = 0, slides = s.children;
              for (var i = 0; i < slides.length; i++) if (slides[i].offsetLeft - s.scrollLeft <= s.clientWidth / 2) k = i;
              n.textContent = (k + 1) + ' / ' + total;
            });
          }, { passive: true });
          media.appendChild(n);
        }
        card.appendChild(media);

        // The big red line is present tense, from the post's real age; the
        // exact time is the quiet sub-line under it (and it ticks).
        var body = L.el('div', 'ls-body'), head = L.el('h3', 'ls-head'), sub = L.el('p', 'ls-sub');
        head.setAttribute('data-t', p.posted_at);
        head.setAttribute('data-town', p.town || '');
        body.appendChild(head);
        sub.appendChild(document.createTextNode('Posted '));
        var when = L.el('time', null, W.ago(p.posted_at));
        when.setAttribute('datetime', p.posted_at);
        when.setAttribute('data-posted', p.posted_at);
        sub.appendChild(when);
        if (p.taken_at && !isNaN(Date.parse(p.taken_at))) sub.appendChild(document.createTextNode(' · taken ' + W.date(p.taken_at)));
        body.appendChild(sub);
        if (p.comment) body.appendChild(L.el('p', 'ls-comment', p.comment));
        card.appendChild(body);
        c.appendChild(card);

        var chip = null;
        c.setAttribute('data-live-box', '');
        c.setLive = function (on) {
          if (on && !chip) {
            chip = L.el('span', 'live-chip');
            chip.appendChild(L.dot(true));
            chip.appendChild(document.createTextNode('LIVE'));
            media.appendChild(chip);
          } else if (!on && chip) { chip.remove(); chip = null; }
          c.classList.toggle('is-live', on);
        };
        c.setLive(L.isLive(p.posted_at));
        return c;
      }
      // Headlines: each post's tier from its real age; k = how many posts of
      // the same tier came before it, so neighbours never repeat. Re-run as
      // time passes (a post moves fresh -> today -> yesterday). The box keeps
      // its height whatever the words (CSS), so a relabel never moves a thing.
      function headlines(now) {
        var seen = {}, hs = document.querySelectorAll('.ls-head');
        for (var i = 0; i < hs.length; i++) {
          var t = hs[i].getAttribute('data-t'), tr = W.tier(t, now), k = seen[tr] || 0;
          seen[tr] = k + 1;
          var s = W.headline({ posted_at: t, town: hs[i].getAttribute('data-town') }, now, k);
          if (hs[i].textContent !== s) hs[i].textContent = s;
        }
      }

      W.relabel = headlines;

      function dayNode(p) {
        var d = L.el('li', 'ls-day'), s = L.el('span', 'ls-day-label', W.dayLabel(p.posted_at));
        d.setAttribute('data-t', p.posted_at);
        d.classList.toggle('is-today', W.dayLabel(p.posted_at) === 'Today');
        d.appendChild(L.el('span', 'ls-node'));
        d.appendChild(s);
        return d;
      }
      function hookNode(p) {
        var hk = W.hook(p, hooks++), h = L.el('li', 'ls-hook'), box = L.el('p', 'ls-hook-text', hk.text),
            a = L.el('a', 'ls-hook-tel', 'Call (256) 616-6760'), b = L.el('a', 'ls-hook-book', 'book online');
        h.setAttribute('data-kind', hk.kind);
        a.href = 'tel:2566166760';
        b.href = BOOK; b.target = '_blank'; b.rel = 'noopener';
        box.appendChild(a);
        box.appendChild(document.createTextNode(' or '));
        box.appendChild(b);
        h.appendChild(L.el('span', 'ls-node'));
        h.appendChild(box);
        return h;
      }

      // Glide to a post in the stream (filmstrip thumbs, the polaroid stack).
      function jumpTo(id, ev) {
        var t = document.getElementById(id);
        if (!t) return false;
        t.classList.remove('is-pending');
        t.scrollIntoView({ behavior: L.reduced ? 'auto' : 'smooth', block: 'start' });
        t.classList.remove('is-pinged'); void t.offsetWidth; t.classList.add('is-pinged');
        if (ev && window.brgTrack) brgTrack(ev);
        return true;
      }

      // Hero backdrop made of the crew's photos: the filmstrip's own w_200
      // URLs (already on the page), tiled, treated dark in CSS, drifting slowly.
      function fillMosaic() {
        var srcs = [];
        shown.forEach(function (p) { photos(p).forEach(function (x) { if (srcs.length < 18) srcs.push({ src: L.small(L.still(x)), video: x.kind === 'video' }); }); });
        if (!srcs.length) return;
        var n = matchMedia('(max-width: 768px)').matches ? 9 : 18, frag = document.createDocumentFragment();
        for (var i = 0; i < n; i++) {
          var img = L.el('img', 'live-mosaic-tile'), t = srcs[i % srcs.length];
          img.alt = ''; img.decoding = 'async'; img.fetchPriority = 'low';
          img.src = t.src;
          frag.appendChild(t.video ? vthumb(img, 'live-mosaic-vid') : img);
        }
        mosaic.appendChild(frag);
        intro.classList.add('has-mosaic');
      }

      // The newest post as a tilted polaroid stack (newest on top, the next
      // two peeking behind): LIVE chip, alive phrase, ticking time. Desktop.
      function fillPolaroids() {
        var top3 = shown.slice(0, 3);
        if (!top3.length) return;
        var a = L.el('a', 'live-pol');
        a.href = '#ls-1';
        a.setAttribute('aria-label', 'Newest post: ' + W.headline(top3[0], null, 0) + ' — jump to it');
        top3.slice().reverse().forEach(function (p) {
          var i = top3.indexOf(p), card = L.el('span', 'pol-card pol-' + i), img = L.el('img');
          var x0 = photos(p)[0];
          img.alt = ''; img.decoding = 'async';
          img.src = L.still(x0);
          card.appendChild(x0.kind === 'video' ? vthumb(img, 'pol-photo') : img);
          if (!i) {
            var cap = L.el('span', 'pol-cap'), when = L.el('span', 'pol-sub', 'Posted ');
            if (L.isLive(p.posted_at)) { var chip = L.el('span', 'live-chip'); chip.appendChild(L.dot(true)); chip.appendChild(document.createTextNode('LIVE')); card.appendChild(chip); }
            cap.appendChild(L.el('span', 'pol-head', W.headline(p, null, 0)));
            var t = L.el('time', null, W.ago(p.posted_at));
            t.setAttribute('datetime', p.posted_at); t.setAttribute('data-posted', p.posted_at);
            when.appendChild(t);
            cap.appendChild(when);
            card.appendChild(cap);
          }
          a.appendChild(card);
        });
        a.addEventListener('click', function (e) { if (jumpTo('ls-1', 'live_polaroid_tap')) e.preventDefault(); });
        pols.appendChild(a);
      }

      // Red ticker: the stats sentence, then the alive phrases of this week's
      // posts. Real posts only; with none this week the static line stays.
      var tickerText = '';
      function fillTicker() {
        var items = [], st = W.stats(shown), seen = {};
        if (st) items.push(st);
        var wk = shown.filter(function (p) { return Date.now() - Date.parse(p.posted_at) < 7 * 86400000; }).slice(0, 10), k = {};
        wk.forEach(function (p) {
          var tr = W.tier(p.posted_at), h = W.headline(p, null, k[tr] = (k[tr] || 0)); k[tr]++;
          if (!seen[h]) { seen[h] = 1; items.push(h); }
        });
        if (!items.length || items.join('|') === tickerText) return;
        tickerText = items.join('|');
        var frag = document.createDocumentFragment();
        for (var r = 0; r < 2; r++) items.forEach(function (x) { frag.appendChild(L.el('span', 'live-ticker-item', x)); });
        ticker.textContent = '';
        ticker.appendChild(frag);
        ticker.style.setProperty('--dur', Math.max(24, items.length * 7) + 's');
        ticker.classList.add('is-rolling');
      }

      // Filmstrip: the latest photos, newest first; a tap glides to the post.
      function fillFilm() {
        var frag = document.createDocumentFragment(), n = 0;
        shown.some(function (p, i) {
          photos(p).forEach(function (x, k) {
            if (n >= FILM_MAX) return;
            var a = L.el('a', 'live-film-thumb' + (!k && L.isLive(p.posted_at) ? ' is-live' : '')), img = L.el('img');
            a.href = '#ls-' + (i + 1);
            a.setAttribute('aria-label', 'Jump to ' + W.headline(p, null, 0) + (x.kind === 'video' ? ' (video)' : k ? ' (photo ' + (k + 1) + ')' : ''));
            img.alt = ''; img.width = 96; img.height = 96; img.decoding = 'async'; img.loading = n < 8 ? 'eager' : 'lazy';
            img.src = L.small(L.still(x));
            a.appendChild(img);
            if (x.kind === 'video') a.appendChild(L.glyph());
            frag.appendChild(a);
            n++;
          });
          return n >= FILM_MAX;
        });
        film.textContent = '';
        film.appendChild(frag);
        film.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href^="#ls-"]');
          if (!a) return;
          if (jumpTo(a.getAttribute('href').slice(1), 'live_film_tap')) e.preventDefault();
        });
      }

      function ld() {
        var graph = [];
        shown.forEach(function (p) {
          photos(p).forEach(function (x) {
            var org = { '@type': 'Organization', name: 'Blue River Gutters', url: 'https://bluerivergutters.com/' }, o;
            if (L.isVideo(x)) {
              // VideoObject: the mp4, its poster, ISO duration; same town-only place.
              var s = L.secs(x.duration);
              o = { '@type': 'VideoObject', name: p.comment || 'Gutter job' + (p.town ? ' in ' + p.town : '') + ' — Blue River Live',
                description: (p.comment ? p.comment + ' — ' : '') + 'Video from a Blue River Gutters job' + (p.town ? ' in ' + p.town + ', AL' : '') + ', posted from the field.',
                contentUrl: L.safe(x.mp4), thumbnailUrl: L.safe(x.poster) || L.still(x), uploadDate: p.posted_at, creator: org };
              if (!isNaN(s)) o.duration = 'PT' + (s >= 60 ? Math.floor(s / 60) + 'M' : '') + (s % 60 || s < 60 ? s % 60 + 'S' : '');
              if (x.w && x.h) { o.width = x.w; o.height = x.h; }
            } else o = { '@type': 'ImageObject', contentUrl: L.safe(x.full) || L.still(x), thumbnailUrl: L.still(x),
              width: x.w, height: x.h, uploadDate: p.posted_at, creator: org };
            if (p.town) o.contentLocation = { '@type': 'Place', name: p.town };
            if (p.taken_at) o.dateCreated = p.taken_at;
            if (p.comment) o.caption = p.comment;
            graph.push(o);
          });
        });
        var s = document.getElementById('live-ld');
        if (!s) { s = document.createElement('script'); s.type = 'application/ld+json'; s.id = 'live-ld'; document.head.appendChild(s); }
        s.textContent = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
      }

      function add(d, lazy) {
        var posts = (d && d.posts) || [], top = document.createDocumentFragment(), below = document.createDocumentFragment(), prev = shown[shown.length - 1];
        posts.forEach(function (p) {
          if (!p || seen[p.id] || !photos(p).length || isNaN(Date.parse(p.posted_at))) return;
          seen[p.id] = 1;
          var before = count;
          // A hook after post n (n % 4 == 0), keyed to that post — not right
          // before the form, and never at the very end (only once another post follows).
          if (before > 0 && before % HOOK_EVERY === 0 && before !== K) (before < K ? top : below).appendChild(hookNode(prev));
          shown.push(p); count++;
          var into = count <= K ? top : below, day = W.dayKey(p.posted_at);
          if (day !== lastDay || before === K) into.appendChild(dayNode(p));
          lastDay = day;
          var el = post(p);
          if (reveal && count > K) { el.classList.add('is-pending'); reveal.observe(el); }
          into.appendChild(el);
          prev = p;
        });
        first.appendChild(top);
        next = d && d.next ? d.next : null;
        more.hidden = !next;
        if (lazy) {
          // First page: the first screen goes in now; the stream below the
          // form card (off screen) follows in small tasks, so no long task
          // holds a slow phone. Load More appends at once (space is reserved).
          var kids = [].slice.call(below.childNodes);
          (function chunk() {
            var f = document.createDocumentFragment();
            kids.splice(0, 8).forEach(function (n) { f.appendChild(n); });
            rest.appendChild(f);
            if (kids.length) setTimeout(chunk, 0); else headlines();
          })();
        } else rest.appendChild(below);
        if (shown.length) {
          headlines();
          var st = W.stats(shown);
          statsEl.textContent = st;
          form2.hidden = count < K + FORM2_AFTER;
          (window.requestIdleCallback || setTimeout)(ld);
          L.startTicking();
        } else down('Nothing posted yet today — the crews are out on jobs.');
      }
      function down(msg) {
        status.textContent = msg;
        empty.hidden = false;
        film.textContent = '';
        film.appendChild(L.el('span', 'live-film-empty', 'The day’s first photos land here as the work wraps up.'));
        first.classList.add('is-empty');
      }

      // Labels age with the page: headlines, day nodes, the stats sentence.
      setInterval(function () {
        if (document.hidden || !shown.length) return;
        headlines();
        var ds = document.querySelectorAll('.ls-day');
        for (var i = 0; i < ds.length; i++) {
          var lab = W.dayLabel(ds[i].getAttribute('data-t'));
          ds[i].lastChild.textContent = lab;
          ds[i].classList.toggle('is-today', lab === 'Today');
        }
        statsEl.textContent = W.stats(shown);
        var ph = pols.querySelector('.pol-head');
        if (ph) ph.textContent = W.headline(shown[0], null, 0);
        fillTicker();
      }, 60000);

      window.brgLiveFirst.then(function (d) { add(d, true); if (shown.length) { fillFilm(); fillMosaic(); fillPolaroids(); fillTicker(); } }, function () {
        down('We couldn’t load the latest photos just now — refresh in a minute.');
      });

      more.addEventListener('click', function () {
        if (busy || !next) return;
        busy = true; more.disabled = true;
        // Reserve a screen of space now, inside the click's input window, so the
        // new posts land in room that already exists.
        rest.style.minHeight = (rest.offsetHeight + innerHeight) + 'px';
        get(next).then(function (d) { more.textContent = 'Load more from the field'; add(d); }, function () {
          more.textContent = 'Couldn’t load — tap to try again';
        }).then(function () {
          busy = false; more.disabled = false;
          requestAnimationFrame(function () { rest.style.minHeight = ''; });
        });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
  })();
</script>
