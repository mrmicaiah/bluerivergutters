{# The first feed page is this page's content (its first photo is the LCP),
   so it is requested before any markup: the bare URL, shared with the
   site-wide strip. The feed can fail before DOMContentLoaded, while nothing
   is listening yet, so the rejection is marked handled at once; start() and
   the strip still get it. #}
<script>
  window.brgLiveFirst = fetch('/api/live/feed', { headers: { accept: 'application/json' } })
    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
  window.brgLiveFirst.catch(function () {});
</script>

{# The mark's display face: Oswald 700, uppercase-only subset (text=), from
   Google Fonts, loaded without blocking render (media=print swap). Until it
   lands — or if it never does — the mark uses condensed system faces. The
   lockup is stacked ("● BLUE RIVER" over a red LIVE bar) with fixed line
   heights; only fixed-size things lead a line and nothing follows a
   font-dependent width, so the swap can't move anything. #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&text=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789%20%C2%B7%E2%80%94-&display=swap" media="print" onload="this.media='all'">

