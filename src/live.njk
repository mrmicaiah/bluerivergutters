{# #live-float, desktop only: a floating booking pill while no booking row,
   form or closing block is on screen, so every scroll position offers a way
   to book (phones have the site's sticky Call / Free Estimate bar). Fixed +
   opacity/transform only: it can never shift the page. #}
<script>
  (function () {
    var f = document.getElementById('live-float');
    if (!f || !('IntersectionObserver' in window)) return;
    var spots = document.querySelectorAll('.live-intro .live-book, #quick-form form, #quick-form-2 form, .live-close .live-book'), on = {};
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { on[[].indexOf.call(spots, e.target)] = e.isIntersecting; });
      var show = !Object.keys(on).some(function (k) { return on[k]; });
      f.classList.toggle('is-on', show);
      if (show) { f.removeAttribute('aria-hidden'); f.removeAttribute('tabindex'); }
      else { f.setAttribute('aria-hidden', 'true'); f.setAttribute('tabindex', '-1'); }
    }, { rootMargin: '-60px 0px -60px 0px' }); // a sliver at the screen edge doesn't count
    function go() { [].forEach.call(spots, function (el) { io.observe(el); }); }
    // Not needed until someone scrolls: keep it out of the first render.
    if (document.readyState === 'complete') go(); else addEventListener('load', go);
  })();
</script>

{# The stream's words and markup: core() from src/_data/liveCore.js — the very
   factory the server renderer (functions/_shared/render.js) uses, inlined
   from its source. Instantiated in start() with window.brgLive (base.njk,
   end of body) as its basics. window.brgStream keeps the page's language
   API (tier, headline, hook, stats, dayLabel, date, ago, dayKey):
   - headline(post, now, k): the big red line, present tense, by age tier;
     k = how many posts of that tier came before, so neighbours never repeat.
     Never "right now", never invented activity.
   - hook(post, k): the crew-voiced line after a post, keyed to its town and
     the words in its comment. No prices, no counts.
   - stats(posts, now): a sentence with life, or "" when it would sound thin.
   America/Chicago days throughout (computed, no Intl time-zone formatter). #}
<script>
  window.brgLiveCore = {{ liveCore.coreSrc | safe }};
</script>

{# Two ways the stream arrives:
   SERVER-RENDERED (the Function at /live/ and /live/page/<n>/ filled
   #live-stream and marked it data-ssr-page="<n>"): the cards are already
   here, so this HYDRATES them — wires batch strips, video tap-to-play, the
   LIVE chips and ticking, upgrades each factual stamp to its present-tense
   line in place (same element, fixed-height box), and never rebuilds a
   card. Page 1 then tops up from the feed: posts newer than the server's
   copy go in at the top, newest first, never twice (by post id) — straight
   away if that spot is below the screen, otherwise behind a "new post" pill
   at the top so nothing on screen moves until the visitor asks. Archive pages are frozen
   history: no top-ups; their filmstrip and polaroid come from the page.
   PLAIN SHELL (no Function: local builds, or the Function fell back): the
   stream is built from the feed as before — the same HTML from the same
   core, then the same hydration. Load More pages it.
   Everything from the feed goes in escaped or as a checked https URL. Town
   only: no coordinates, in the posts or the JSON-LD. #}
<script>
  (function () {
    function get(cursor) {
      return fetch('/api/live/feed' + (cursor ? '?cursor=' + encodeURIComponent(cursor) : ''), { headers: { accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
    }
    if (!window.brgLiveFirst) { window.brgLiveFirst = get(null); window.brgLiveFirst.catch(function () {}); }
    if (window.brgTrack) brgTrack('live_page_view');

    var FILM_MAX = 16, FORM2_AFTER = 6;
    function start() {
      var L = window.brgLive, C = window.brgCore || (window.brgCore = window.brgLiveCore(L)),
          first = document.getElementById('live-stream'), rest = document.getElementById('live-stream-more'),
          status = document.getElementById('live-status'), statsEl = document.getElementById('live-stats'),
          film = document.getElementById('live-film'), empty = document.getElementById('live-empty'),
          more = document.getElementById('live-more'), form2 = document.getElementById('quick-form-2'),
          intro = document.getElementById('live-intro'), mosaic = document.getElementById('live-mosaic'),
          pols = document.getElementById('live-polaroids'), ticker = document.getElementById('live-ticker-track'),
          shown = [], ids = {}, next = null, busy = false, reveal = null;
      var W = window.brgStream = { tier: C.tier, headline: C.headline, hook: C.hook, stats: C.stats, dayLabel: C.dayLabel, date: C.date, ago: C.ago, dayKey: C.dayKey };
      var ssrPage = +first.getAttribute('data-ssr-page') || 0;
      // Where the form card sits: after post K. The server always uses 2; the
      // plain shell keeps its 2 (phone) / 3 (desktop).
      var K = ssrPage ? 2 : matchMedia('(max-width: 768px)').matches ? 2 : 3;
      var st = C.state({ K: K, alive: true });

      // Posts further down hang onto the rail as they scroll into view.
      if (!L.reduced && 'IntersectionObserver' in window) {
        reveal = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.remove('is-pending'); reveal.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
      }
      function pend(li) { if (reveal) { li.classList.add('is-pending'); reveal.observe(li); } }
      function html(s) { var t = document.createElement('template'); t.innerHTML = s; return t.content; }

      // Inline playback: a tap lays a <video> over the poster in the slide's
      // reserved box — muted, playsinline, no autoplay, native controls once
      // it plays (for sound) — and nothing loads before that tap. One plays
      // at a time; one scrolled or swiped out of sight pauses.
      var seenV = 'IntersectionObserver' in window ? new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (!e.isIntersecting && !e.target.paused) e.target.pause(); });
      }, { threshold: 0.2 }) : null;
      document.addEventListener('play', function (e) {
        var vs = document.querySelectorAll('video.live-video');
        for (var i = 0; i < vs.length; i++) if (vs[i] !== e.target && !vs[i].paused) vs[i].pause();
      }, true);
      function playIn(slide, btn) {
        var img = slide.querySelector('img'), chip = slide.querySelector('.live-dur'), v = L.el('video', 'live-video');
        v.muted = true; v.defaultMuted = true; v.setAttribute('muted', '');
        v.playsInline = true; v.setAttribute('playsinline', ''); v.setAttribute('webkit-playsinline', '');
        v.preload = 'none';
        v.poster = img.currentSrc || img.src;
        v.controls = true;
        v.setAttribute('aria-label', btn.getAttribute('aria-label').replace(/^Play video(, [0-9:]+)? — /, 'Video: '));
        v.src = L.safe(slide.getAttribute('data-mp4'));
        slide.appendChild(v);
        btn.hidden = true; if (chip) chip.hidden = true;
        if (seenV) seenV.observe(v);
        var pr = v.play();
        if (pr && pr.catch) pr.catch(function () { /* controls are there to start it by hand */ });
        try { v.focus({ preventScroll: true }); } catch (err) {}
        if (window.brgTrack) brgTrack('live_video_play');
      }

      // A card's data, read back from its own markup (server-rendered cards
      // carry it all), for the filmstrip, polaroid, ticker and JSON-LD.
      function read(li) {
        var c = li.querySelector('.ls-comment'), p = {
          id: li.getAttribute('data-id'), posted_at: li.getAttribute('data-t'), town: li.getAttribute('data-town') || '',
          taken_at: li.getAttribute('data-taken') || null, count: +li.getAttribute('data-count') || 0, comment: c ? c.textContent : null, photos: [] };
        [].forEach.call(li.querySelectorAll('.live-slide'), function (s) {
          var img = s.querySelector('img'), x = { w: +img.getAttribute('width'), h: +img.getAttribute('height'), thumb: img.getAttribute('src') };
          if (s.classList.contains('is-video')) { x.kind = 'video'; x.mp4 = s.getAttribute('data-mp4'); x.poster = s.getAttribute('data-poster'); x.duration = +s.getAttribute('data-duration') || null; }
          else x.full = s.getAttribute('href');
          p.photos.push(x);
        });
        return p;
      }

      // Cards need no listeners of their own: one delegated click handler on
      // the stream runs every batch strip's count button and every video's
      // play control (server-rendered or built here), and one capturing
      // scroll listener keeps each strip's "2 / 4" current. Installed at
      // once, so a tap before the rest of hydration still plays inline.
      function onStream(list) {
        list.addEventListener('click', function (e) {
          var t = e.target.closest && e.target.closest('.live-play, .live-count');
          if (!t) return;
          if (t.classList.contains('live-play')) {
            if (!t.parentNode.classList.contains('is-video')) return;
            e.preventDefault();
            return playIn(t.parentNode, t);
          }
          var s = t.parentNode.querySelector('.live-strip'), atEnd = s.scrollLeft + s.clientWidth >= s.scrollWidth - 4;
          s.scrollTo({ left: atEnd ? 0 : s.scrollLeft + s.clientWidth * 0.9, behavior: L.reduced ? 'auto' : 'smooth' });
        });
        list.addEventListener('scroll', function (e) {
          var s = e.target;
          if (!s.classList || !s.classList.contains('live-strip') || s.__raf) return;
          s.__raf = requestAnimationFrame(function () {
            s.__raf = 0;
            var n = s.parentNode.querySelector('.live-count');
            if (!n) return;
            var k = 0, slides = s.children, li = s.closest('.ls-post');
            for (var i = 0; i < slides.length; i++) if (slides[i].offsetLeft - s.scrollLeft <= s.clientWidth / 2) k = i;
            n.textContent = (k + 1) + ' / ' + (+li.getAttribute('data-count') || slides.length);
          });
        }, { capture: true, passive: true });
      }
      onStream(first); onStream(rest);

      // Hydrate one card: its LIVE state follows the clock (brgLive.tick
      // calls setLive). The card already shows the state as of when it was
      // rendered, so nothing is touched now.
      function wire(li) {
        var media = li.querySelector('.live-media');
        li.setLive = function (on) {
          var chip = media.querySelector('.live-chip');
          if (on && !chip) {
            chip = L.el('span', 'live-chip');
            chip.appendChild(L.dot(true));
            chip.appendChild(document.createTextNode('LIVE'));
            media.appendChild(chip);
          } else if (!on && chip) chip.remove();
          li.classList.toggle('is-live', on);
        };
        ids[li.getAttribute('data-id')] = li.id;
        return li;
      }

      // Headlines: each post's tier from its real age; k = how many posts of
      // the same tier came before it. Re-run as time passes (fresh -> today ->
      // yesterday). The box keeps its height whatever the words (CSS), so the
      // upgrade from the server's stamp — and every relabel — moves nothing.
      function headlines(now) {
        var seen = {}, hs = document.querySelectorAll('.ls-head');
        for (var i = 0; i < hs.length; i++) {
          var t = hs[i].getAttribute('data-t'), tr = W.tier(t, now), k = seen[tr] || 0;
          seen[tr] = k + 1;
          var s = W.headline({ posted_at: t, town: hs[i].getAttribute('data-town') }, now, k);
          if (hs[i].textContent !== s) hs[i].textContent = s;
        }
      }
      W.relabel = headlines;

      // Glide to a post in the stream (filmstrip thumbs, the polaroid stack).
      function jumpTo(id, ev) {
        var t = document.getElementById(id);
        if (!t) return false;
        t.classList.remove('is-pending');
        t.scrollIntoView({ behavior: L.reduced ? 'auto' : 'smooth', block: 'start' });
        t.classList.remove('is-pinged'); void t.offsetWidth; t.classList.add('is-pinged');
        if (ev && window.brgTrack) brgTrack(ev);
        return true;
      }
      function cardId(p) { return ids[p.id] || ''; }
      function vthumb(img, cls) {
        var w = L.el('span', cls);
        w.appendChild(img);
        w.appendChild(L.glyph());
        return w;
      }

      // Hero backdrop made of the crew's photos: the filmstrip's own w_200
      // URLs, tiled, treated dark in CSS, drifting slowly.
      function fillMosaic() {
        var srcs = [];
        shown.forEach(function (p) { C.photos(p).forEach(function (x) { if (srcs.length < 18) srcs.push({ src: L.small(L.still(x)), video: x.kind === 'video' }); }); });
        if (!srcs.length || mosaic.firstChild) return;
        var n = matchMedia('(max-width: 768px)').matches ? 9 : 18, frag = document.createDocumentFragment();
        for (var i = 0; i < n; i++) {
          var img = L.el('img', 'live-mosaic-tile'), t = srcs[i % srcs.length];
          img.alt = ''; img.decoding = 'async'; img.fetchPriority = 'low';
          img.src = t.src;
          frag.appendChild(t.video ? vthumb(img, 'live-mosaic-vid') : img);
        }
        mosaic.appendChild(frag);
        intro.classList.add('has-mosaic');
      }

      // The newest post as a tilted polaroid stack (newest on top, the next
      // two peeking behind): LIVE chip, alive phrase, ticking time. Desktop.
      function fillPolaroids() {
        var top3 = shown.slice(0, 3);
        if (!top3.length) return;
        var a = L.el('a', 'live-pol'), to = cardId(top3[0]);
        a.href = '#' + to;
        a.setAttribute('aria-label', 'Newest post: ' + W.headline(top3[0], null, 0) + ' — jump to it');
        top3.slice().reverse().forEach(function (p) {
          var i = top3.indexOf(p), card = L.el('span', 'pol-card pol-' + i), img = L.el('img'), x0 = C.photos(p)[0];
          img.alt = ''; img.decoding = 'async';
          img.src = L.still(x0);
          card.appendChild(x0.kind === 'video' ? vthumb(img, 'pol-photo') : img);
          if (!i) {
            var cap = L.el('span', 'pol-cap'), when = L.el('span', 'pol-sub', 'Posted ');
            if (L.isLive(p.posted_at)) { var chip = L.el('span', 'live-chip'); chip.appendChild(L.dot(true)); chip.appendChild(document.createTextNode('LIVE')); card.appendChild(chip); }
            cap.appendChild(L.el('span', 'pol-head', W.headline(p, null, 0)));
            var t = L.el('time', null, W.ago(p.posted_at));
            t.setAttribute('datetime', p.posted_at); t.setAttribute('data-posted', p.posted_at);
            when.appendChild(t);
            cap.appendChild(when);
            card.appendChild(cap);
          }
          a.appendChild(card);
        });
        a.addEventListener('click', function (e) { if (jumpTo(to, 'live_polaroid_tap')) e.preventDefault(); });
        pols.textContent = '';
        pols.appendChild(a);
      }

      // Red ticker: the stats sentence, then the alive phrases of this week's
      // posts. Real posts only; with none this week the static line stays.
      var tickerText = '';
      function fillTicker() {
        var items = [], s = W.stats(shown), seen = {};
        if (s) items.push(s);
        var wk = shown.filter(function (p) { return Date.now() - Date.parse(p.posted_at) < 7 * 86400000; }).slice(0, 10), k = {};
        wk.forEach(function (p) {
          var tr = W.tier(p.posted_at), h = W.headline(p, null, k[tr] = (k[tr] || 0)); k[tr]++;
          if (!seen[h]) { seen[h] = 1; items.push(h); }
        });
        if (!items.length || items.join('|') === tickerText) return;
        tickerText = items.join('|');
        var frag = document.createDocumentFragment();
        for (var r = 0; r < 2; r++) items.forEach(function (x) { frag.appendChild(L.el('span', 'live-ticker-item', x)); });
        ticker.textContent = '';
        ticker.appendChild(frag);
        ticker.style.setProperty('--dur', Math.max(24, items.length * 7) + 's');
        ticker.classList.add('is-rolling');
      }

      // Filmstrip: the latest photos, newest first; a tap glides to the post.
      var filmWired = false;
      function fillFilm() {
        var frag = document.createDocumentFragment(), n = 0;
        shown.some(function (p) {
          C.photos(p).forEach(function (x, k) {
            if (n >= FILM_MAX) return;
            var a = L.el('a', 'live-film-thumb' + (!k && L.isLive(p.posted_at) ? ' is-live' : '')), img = L.el('img');
            a.href = '#' + cardId(p);
            a.setAttribute('aria-label', 'Jump to ' + W.headline(p, null, 0) + (x.kind === 'video' ? ' (video)' : k ? ' (photo ' + (k + 1) + ')' : ''));
            img.alt = ''; img.width = 96; img.height = 96; img.decoding = 'async'; img.loading = n < 8 ? 'eager' : 'lazy';
            img.src = L.small(L.still(x));
            a.appendChild(img);
            if (x.kind === 'video') a.appendChild(L.glyph());
            frag.appendChild(a);
            n++;
          });
          return n >= FILM_MAX;
        });
        film.textContent = '';
        film.appendChild(frag);
        if (filmWired) return;
        filmWired = true;
        film.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href^="#ls-"]');
          if (!a) return;
          if (jumpTo(a.getAttribute('href').slice(1), 'live_film_tap')) e.preventDefault();
        });
      }
      function fillHero() { if (!shown.length) return; fillFilm(); fillMosaic(); fillPolaroids(); fillTicker(); }

      function ld() {
        var graph = [];
        shown.forEach(function (p) {
          C.photos(p).forEach(function (x) {
            var org = { '@type': 'Organization', name: 'Blue River Gutters', url: 'https://bluerivergutters.com/' }, o;
            if (L.isVideo(x)) {
              // VideoObject: the mp4, its poster, ISO duration; same town-only place.
              var s = L.secs(x.duration);
              o = { '@type': 'VideoObject', name: p.comment || 'Gutter job' + (p.town ? ' in ' + p.town : '') + ' — Blue River Live',
                description: (p.comment ? p.comment + ' — ' : '') + 'Video from a Blue River Gutters job' + (p.town ? ' in ' + p.town + ', AL' : '') + ', posted from the field.',
                contentUrl: L.safe(x.mp4), thumbnailUrl: L.safe(x.poster) || L.still(x), uploadDate: p.posted_at, creator: org };
              if (!isNaN(s)) o.duration = 'PT' + (s >= 60 ? Math.floor(s / 60) + 'M' : '') + (s % 60 || s < 60 ? s % 60 + 'S' : '');
              if (x.w && x.h) { o.width = x.w; o.height = x.h; }
            } else o = { '@type': 'ImageObject', contentUrl: L.safe(x.full) || L.still(x), thumbnailUrl: L.still(x),
              width: x.w, height: x.h, uploadDate: p.posted_at, creator: org };
            if (p.town) o.contentLocation = { '@type': 'Place', name: p.town };
            if (p.taken_at) o.dateCreated = p.taken_at;
            if (p.comment) o.caption = p.comment;
            graph.push(o);
          });
        });
        var s = document.getElementById('live-ld');
        if (!s) { s = document.createElement('script'); s.type = 'application/ld+json'; s.id = 'live-ld'; document.head.appendChild(s); }
        s.textContent = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
      }

      function settle() {
        headlines();
        statsEl.textContent = W.stats(shown);
        (window.requestIdleCallback || setTimeout)(ld);
        L.startTicking();
      }
      function down(msg) {
        status.textContent = msg;
        empty.hidden = false;
        film.textContent = '';
        film.appendChild(L.el('span', 'live-film-empty', 'The day’s first photos land here as the work wraps up.'));
        first.classList.add('is-empty');
      }

      // ---- PLAIN SHELL: build from the feed (first page and Load More).
      // The first screen (posts 1..K) is parsed and placed at once; the
      // stream below the form card (off screen) follows in small tasks, so no
      // long task holds a slow phone. Load More appends at once (space is
      // reserved). The data is known up front (shown), so the hero strip
      // doesn't wait for the cards.
      function place(items, into, done) {
        var f = html(items.map(function (it) { return it.html; }).join(''));
        [].forEach.call(f.querySelectorAll('li.ls-post'), function (li) {
          wire(li);
          if (+li.id.slice(3) > K) pend(li);
        });
        into.appendChild(f);
        if (done) done();
      }
      function add(d, lazy) {
        var posts = ((d && d.posts) || []).filter(function (p) { return p && !ids[p.id]; });
        var items = C.sequence(posts, st).filter(function (it) { return it.type !== 'form'; }); // the form card sits between the two lists
        var top = items.filter(function (it) { return it.n <= K; }), below = items.filter(function (it) { return it.n > K; });
        items.forEach(function (it) { if (it.type === 'post') { shown.push(it.post); ids[it.post.id] = 'ls-' + it.n; } });
        place(top, first);
        next = d && d.next ? d.next : null;
        more.hidden = !next;
        if (lazy) (function chunk() {
          place(below.splice(0, 8), rest, function () { if (below.length) setTimeout(chunk, 0); else headlines(); });
        })();
        else place(below, rest);
        if (shown.length) {
          form2.hidden = st.count < K + FORM2_AFTER;
          settle();
        } else down('Nothing posted yet today — the crews are out on jobs.');
      }

      // ---- SERVER-RENDERED: hydrate, then (page 1) top up from the feed.
      // Before the first paint only the stamps become present-tense lines
      // (text in fixed-height boxes: no layout read, no move, no flash).
      // The rest waits for the first frame: read the cards' data back, mark
      // the ones below the screen for the slide-in (all positions read first,
      // then classes written — one layout), then the clock.
      var hydrated = null;
      function hydrate() {
        headlines();
        hydrated = new Promise(function (done) {
          requestAnimationFrame(function () { setTimeout(function () {
            var lis = [].slice.call(first.querySelectorAll('li.ls-post'));
            lis.forEach(function (li) { shown.push(read(wire(li))); });
            if (!shown.length) { down('Nothing posted yet today — the crews are out on jobs.'); return done(); }
            var h = innerHeight, below = lis.filter(function (li) { return li.getBoundingClientRect().top >= h; });
            below.forEach(pend);
            settle();
            done();
          }, 0); });
        });
      }
      // Posts newer than the server's copy (it is cached up to a minute), in
      // at the top, newest first, never twice. Zigzag sides continue from the
      // card they land above; a day node opens a newer day.
      function topUp(posts) {
        var newest = Date.parse(shown.length ? shown[0].posted_at : 0) || 0;
        var fresh = (posts || []).filter(function (p) { return C.ok(p) && !ids[p.id] && Date.parse(p.posted_at) > newest; });
        if (!fresh.length) return;
        var anchorDay = first.querySelector('li.ls-day'), firstPost = first.querySelector('li.ls-post');
        var anchorKey = anchorDay ? W.dayKey(anchorDay.getAttribute('data-t')) : null;
        var side = firstPost && firstPost.classList.contains('is-left') ? 'is-left' : 'is-right';
        var imgs = { img: 1 };
        function put() {
          var m = fresh.length, before = document.createDocumentFragment(), after = document.createDocumentFragment(), lastKey = null, built = [];
          fresh.forEach(function (p, i) {
            var key = W.dayKey(p.posted_at), into = key === anchorKey ? after : before;
            if (key !== lastKey && key !== anchorKey) before.appendChild(html(C.day(p)).firstChild);
            lastKey = key;
            var sd = (m - 1 - i) % 2 ? side : side === 'is-left' ? 'is-right' : 'is-left';
            var node = html(C.card(p, { id: 'ls-n' + (++topUp.n), side: sd, alive: true, st: imgs })).firstChild;
            into.appendChild(node);
            built.push(node);
          });
          var ref = anchorDay || firstPost;
          if (ref) { ref.parentNode.insertBefore(before, ref); if (anchorDay) anchorDay.parentNode.insertBefore(after, anchorDay.nextSibling); else ref.parentNode.insertBefore(after, ref); }
          else first.appendChild(before), first.appendChild(after);
          built.forEach(wire);
          shown = fresh.concat(shown);
          settle();
          fillHero();
        }
        // Below the screen: in now — nothing on screen moves. Anywhere else (on
        // screen, or already scrolled past, where inserting above would shove
        // the page): a pill over the "newest at the top" line, absolutely
        // positioned so it moves nothing either; a tap puts them in.
        if ((anchorDay || firstPost).getBoundingClientRect().top >= innerHeight) return put();
        var top = first.querySelector('.ls-top'), pill = L.el('button', 'ls-fresh', '↑ ' + fresh.length + ' new post' + (fresh.length === 1 ? '' : 's') + ' from the field');
        pill.type = 'button';
        pill.addEventListener('click', function () { pill.remove(); put(); if (window.brgTrack) brgTrack('live_fresh_tap'); });
        top.appendChild(pill);
      }
      topUp.n = 0;

      // Labels age with the page: headlines, day nodes, the stats sentence.
      setInterval(function () {
        if (document.hidden || !shown.length) return;
        headlines();
        var ds = document.querySelectorAll('.ls-day');
        for (var i = 0; i < ds.length; i++) {
          var lab = W.dayLabel(ds[i].getAttribute('data-t'));
          if (ds[i].lastChild.textContent !== lab) ds[i].lastChild.textContent = lab;
          ds[i].classList.toggle('is-today', lab === 'Today');
        }
        statsEl.textContent = W.stats(shown);
        var ph = pols.querySelector('.pol-head');
        if (ph) ph.textContent = W.headline(shown[0], null, 0);
        fillTicker();
      }, 60000);

      if (ssrPage) {
        hydrate();
        if (ssrPage === 1) {
          Promise.all([window.brgLiveFirst.catch(function () { return null; }), hydrated]).then(function (r) { topUp(r[0] && r[0].posts); fillHero(); });
        } else hydrated.then(function () { if (document.readyState === 'complete') fillHero(); else addEventListener('load', fillHero); });
      } else {
        window.brgLiveFirst.then(function (d) { add(d, true); fillHero(); }, function () {
          down('We couldn’t load the latest photos just now — refresh in a minute.');
        });
        more.addEventListener('click', function () {
          if (busy || !next) return;
          busy = true; more.disabled = true;
          // Reserve a screen of space now, inside the click's input window, so the
          // new posts land in room that already exists.
          rest.style.minHeight = (rest.offsetHeight + innerHeight) + 'px';
          get(next).then(function (d) { more.textContent = 'Load more from the field'; add(d); }, function () {
            more.textContent = 'Couldn’t load — tap to try again';
          }).then(function () {
            busy = false; more.disabled = false;
            requestAnimationFrame(function () { rest.style.minHeight = ''; });
          });
        });
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
  })();
</script>
