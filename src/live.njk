{# The first feed page is this page's content (its first photo is the LCP),
   so it is requested before any markup: the bare URL, shared with the
   site-wide strip. The feed can fail before DOMContentLoaded, while nothing
   is listening yet, so the rejection is marked handled at once; start() and
   the strip still get it. #}
<script>
  window.brgLiveFirst = fetch('/api/live/feed', { headers: { accept: 'application/json' } })
    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
  window.brgLiveFirst.catch(function () {});
</script>

