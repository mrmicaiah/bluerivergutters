{# Hero with background image #}
<section class="hero hero-short" style="background-image: url('https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/hero-bg_axhlw4.jpg');">
  <div class="hero-overlay"></div>
  <div class="container hero-container">
    <div class="hero-content">
      <p class="hero-eyebrow">Our Work</p>
      <h1>Recent Projects</h1>
      <p>Browse our latest gutter installations, repairs, and cleaning projects across North Alabama. Every job reflects our commitment to quality workmanship and customer satisfaction.</p>
    </div>
  </div>
</section>

{# Filter Buttons #}
<section class="projects-filters">
  <div class="container">
    <div class="filter-buttons">
      <button class="filter-btn active" data-filter="all">All Projects</button>
      <button class="filter-btn" data-filter="Seamless Gutters">Seamless Gutters</button>
      <button class="filter-btn" data-filter="Gutter Guards">Gutter Guards</button>
      <button class="filter-btn" data-filter="Underground Drains">Underground Drains</button>
      <button class="filter-btn" data-filter="Rotten Wood Repair">Wood Repair</button>
    </div>
  </div>
</section>

{# Projects Grid #}
<section class="projects-gallery">
  <div class="container">
    <div class="projects-grid">
      {% for project in projects %}
      <a href="{{ '/projects/' | url }}{{ project.slug }}/" class="project-card" data-service="{{ project.service }}">
        <div class="project-card-image">
          <img src="{{ project.thumbnail }}" alt="{{ project.title }}" loading="lazy">
          {% if project.featured %}
          <span class="featured-badge">Featured</span>
          {% endif %}
        </div>
        <div class="project-card-content">
          <span class="project-tag">{{ project.service }}</span>
          <h3>{{ project.title }}</h3>
          <p>{{ project.description }}</p>
          <div class="project-meta">
            <span class="project-location">📍 {{ project.city }}, AL</span>
            <span class="project-date">{{ project.date | date: "%b %Y" }}</span>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
    
    {# Empty state for filtered results #}
    <div class="projects-empty" style="display: none;">
      <p>No projects found for this filter. <button class="filter-reset">View all projects</button></p>
    </div>
  </div>
</section>

{# Stats Section #}
