<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Blue River Gutters | North Alabama Gutter Services") }}</title>
  <meta name="description" content="{{ meta_description | default(description) | default("Professional gutter installation, repair, and cleaning in Huntsville, Madison, Decatur, and throughout North Alabama. 20+ years experience.") }}">
  
  {# Favicon #}
  <link rel="icon" type="image/png" sizes="32x32" href="https://res.cloudinary.com/dxzw1zwez/image/upload/favicon-32x32_dogbih.png">
  
  {# Google Analytics #}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GT8EBK75TK"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GT8EBK75TK');
  </script>
  
  {# Open Graph #}
  <meta property="og:title" content="{{ title | default("Blue River Gutters") }}">
  <meta property="og:description" content="{{ meta_description | default(description) | default("Professional gutter services in North Alabama.") }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://bluerivergutters.com{{ page.url }}">
  <meta property="og:image" content="{{ ogImage | default("https://res.cloudinary.com/dxzw1zwez/image/upload/hero-bg_axhlw4.jpg") }}">
  
  {# Fonts #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  {# Styles #}
  <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/navigation.css' | url }}">
  {% if extraCss %}
  <link rel="stylesheet" href="{{ '/css/' | url }}{{ extraCss }}">
  {% endif %}
  
  {# Canonical URL #}
  <link rel="canonical" href="https://bluerivergutters.com{{ page.url }}">
  
  {# Schema markup slot #}
  {% block schema %}{% endblock %}
</head>
<body>
  
  {% include "partials/header.njk" %}
  
  <main>
    {% block content %}
    {{ content | safe }}
    {% endblock %}
  </main>
  
  {% include "partials/footer.njk" %}
  
  {# Navigation JS (dropdowns, mobile menu, accordions) #}
  <script src="{{ '/js/navigation.js' | url }}"></script>
  
  {# FAQ accordion #}
  <script>
    document.querySelectorAll('.faq-question').forEach(button => {
      button.addEventListener('click', () => {
        const faqItem = button.parentElement;
        const isOpen = faqItem.classList.contains('active');
        
        // Close all
        document.querySelectorAll('.faq-item').forEach(item => {
          item.classList.remove('active');
        });
        
        // Open clicked if it was closed
        if (!isOpen) {
          faqItem.classList.add('active');
        }
      });
    });
  </script>
  
  {# Additional scripts slot #}
  {% block scripts %}{% endblock %}
  
</body>
</html>
