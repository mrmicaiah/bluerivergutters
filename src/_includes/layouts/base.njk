<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Blue River Gutters | North Alabama Gutter Services") }}</title>
  <meta name="description" content="{{ meta_description | default(description) | default("Professional gutter installation, repair, and cleaning in Huntsville, Madison, Decatur, and throughout North Alabama. 20+ years experience.") }}">
  
  {# Favicon #}
  <link rel="icon" type="image/jpeg" sizes="60x60" href="https://res.cloudinary.com/dxzw1zwez/image/upload/Favicon_edited_vk3gls.jpg">
  
  {# LCP hero preload — must come BEFORE other resource hints.
     The hero is a CSS background, so the browser can't discover it until the
     stylesheet is parsed. Paired media preloads match the .rsp-bg
     768px breakpoint in main.css, so each device fetches only the variant it
     will paint. Pages set lcp_hero (+ lcp_hero_crop) in frontmatter; article,
     city and service layouts derive it from hero_kind + hero_image. #}
  {% set lcpHero = lcp_hero %}
  {% set lcpCrop = lcp_hero_crop | default(hero_crop) | default('tall') %}
  {% if not lcpHero %}
    {% if hero_kind == 'article' %}{% set lcpHero = hero_image | default(heroes.article) %}
    {% elif hero_kind == 'city' %}{% set lcpHero = hero_image | default(heroes.city) %}
    {% elif hero_kind == 'service' %}{% set lcpHero = hero_image | default(heroes.services[service_slug] | default(heroes.service)) %}
    {% endif %}
  {% endif %}
  {% if lcpHero %}
  <link rel="preload" as="image" fetchpriority="high" href="{{ lcpHero | mobileBg(lcpCrop) }}" media="(max-width: 768px)">
  <link rel="preload" as="image" fetchpriority="high" href="{{ lcpHero }}" media="(min-width: 769px)">
  {% endif %}
  
  {# Google Analytics — idle-loaded. gtag.js evaluation is a 120–230ms main-thread
     task on mobile; loaded eagerly it collides with early taps (INP). It now
     loads 3s after window load, in idle time. The gtag() calls below queue in
     dataLayer and are replayed when gtag.js arrives. Never trigger the load
     from a user interaction: that moves the cost onto the first tap. #}
  <script>
    addEventListener('load', function () {
      setTimeout(function () {
        (window.requestIdleCallback || setTimeout)(function () {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-GT8EBK75TK';
          document.head.appendChild(s);
        }, { timeout: 2000 });
      }, 3000);
    });
  </script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GT8EBK75TK');
  </script>
  
  {# Microsoft Clarity - heatmaps & session recordings (project: wxpmxnmcqn) #}
  {% raw %}
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wxpmxnmcqn");
  </script>
  {% endraw %}

  {# Clarity custom events — phone clicks. Form events live in /js/lead-form.js.
     Every call goes through brgTrack, which no-ops if Clarity is blocked,
     ad-filtered, or simply hasn't loaded yet. Never call clarity() bare. #}
  {% raw %}
  <script>
    (function () {
      function brgTrack(name) {
        try {
          if (window.clarity) window.clarity('event', name);
        } catch (err) { /* analytics must never break the page */ }
      }
      window.brgTrack = brgTrack;

      // Phone clicks, delegated from document so it covers the hero, both
      // sticky bars, inline CTA boxes, headers, footers — and anything added
      // later — without needing to be re-wired. Capture phase so a handler
      // that stops propagation can't swallow it.
      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || typeof t.closest !== 'function') return;
        if (t.closest('a[href^="tel:"]')) brgTrack('phone_click');
      }, true);

      // Form starts and submits are not wired here: /js/lead-form.js owns
      // all four forms' Clarity events (BRGLeadGuards.instrument).
    })();
  </script>
  {% endraw %}
  
  {# Open Graph #}
  <meta property="og:title" content="{{ title | default("Blue River Gutters") }}">
  <meta property="og:description" content="{{ meta_description | default(description) | default("Professional gutter services in North Alabama.") }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://bluerivergutters.com{{ page.url }}">
  <meta property="og:image" content="{{ ogImage | default("https://res.cloudinary.com/dxzw1zwez/image/upload/hero-bg_axhlw4.jpg") }}">
  
  {# Fonts - Source Sans 3, self-hosted (variable 400–700, @font-face in main.css).
     Preloading the latin file lets it download in parallel with main.css
     instead of waiting for the stylesheet to be parsed. #}
  <link rel="preload" as="font" type="font/woff2" href="{{ '/fonts/source-sans-3-latin.woff2' | url }}" crossorigin>
  
  {# Combined Stylesheet (styles + navigation + parallax merged for perf) #}
  <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
  {% if extraCss %}
  <link rel="stylesheet" href="{{ '/css/' | url }}{{ extraCss }}">
  {% endif %}
  
  {# Canonical URL #}
  <link rel="canonical" href="https://bluerivergutters.com{{ page.url }}">
  
  {# Schema markup slot #}
  {% block schema %}{% endblock %}
</head>
<body>
  
  {% include "partials/header.njk" %}
  {% include "partials/live-banner.njk" %}

  <main>
    {% block content %}
    {{ content | safe }}
    {% endblock %}
  </main>
  
  {% include "partials/footer.njk" %}
  
  {# Navigation JS (dropdowns, mobile menu, accordions) #}
  <script src="{{ '/js/navigation.js' | url }}"></script>
  
  {# FAQ accordion #}
  <script>
    document.querySelectorAll('.faq-question').forEach(button => {
      button.addEventListener('click', () => {
        const faqItem = button.parentElement;
        const isOpen = faqItem.classList.contains('active');
        
        // Close all
        document.querySelectorAll('.faq-item').forEach(item => {
          item.classList.remove('active');
        });
        
        // Open clicked if it was closed
        if (!isOpen) {
          faqItem.classList.add('active');
        }
      });
    });
  </script>
  
  {# Animated stat counter #}
  <script>
    (function() {
      const counters = document.querySelectorAll('.stat-number');
      if (!counters.length) return;
      
      let animated = false;
      
      function animateCounter(el) {
        const text = el.textContent;
        // Extract number and any suffix (like +, ★, ", etc)
        const match = text.match(/^([\d,]+)(.*)/);
        if (!match) return;
        
        const target = parseInt(match[1].replace(/,/g, ''));
        const suffix = match[2] || '';
        const duration = 1500;
        const start = performance.now();
        
        function update(now) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          // Ease out cubic
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = Math.floor(target * eased);
          
          // Format with commas
          el.textContent = current.toLocaleString() + suffix;
          
          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            el.textContent = target.toLocaleString() + suffix;
          }
        }
        
        requestAnimationFrame(update);
      }
      
      function checkVisibility() {
        if (animated) return;
        
        const statsSection = document.querySelector('.stats-section');
        if (!statsSection) return;
        
        const rect = statsSection.getBoundingClientRect();
        const isVisible = rect.top < window.innerHeight * 0.8 && rect.bottom > 0;
        
        if (isVisible) {
          animated = true;
          counters.forEach(counter => animateCounter(counter));
        }
      }
      
      // Use Intersection Observer if available
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !animated) {
              animated = true;
              counters.forEach(counter => animateCounter(counter));
              observer.disconnect();
            }
          });
        }, { threshold: 0.3 });
        
        const statsSection = document.querySelector('.stats-section');
        if (statsSection) observer.observe(statsSection);
      } else {
        // Fallback for older browsers
        window.addEventListener('scroll', checkVisibility);
        checkVisibility();
      }
    })();
  </script>
  
  {# Local-visitor check: window.brgLocal resolves true for Alabama/Tennessee
     visitors (via /geo.json, a Pages Function reading Cloudflare's edge geo).
     Fetched after load in idle time so it costs nothing at load; the answer is
     cached for the session. If the fetch fails, a Central-time timezone counts
     as local — over-broad on purpose: better to show the local box to a Texan
     than hide it from Huntsville. On true, [data-local-only] blocks still below
     the viewport are revealed; any the visitor has already scrolled past stay
     hidden, so on-screen content never shifts. #}
  <script>
    window.brgLocal = new Promise(function (resolve) {
      var KEY = 'brgLocal', LOCAL = ['Alabama', 'Tennessee'];
      function tzGuess() {
        try { return Intl.DateTimeFormat().resolvedOptions().timeZone === 'America/Chicago'; }
        catch (err) { return false; }
      }
      function done(isLocal) {
        try { sessionStorage.setItem(KEY, isLocal ? '1' : '0'); } catch (err) {}
        resolve(isLocal);
      }
      function check() {
        var cached = null;
        try { cached = sessionStorage.getItem(KEY); } catch (err) {}
        if (cached !== null) return resolve(cached === '1');
        fetch('/geo.json', { cache: 'no-store' })
          .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
          .then(function (geo) { done(geo.country === 'US' && LOCAL.indexOf(geo.region) !== -1); })
          .catch(function () { done(tzGuess()); });
      }
      function idle() { (window.requestIdleCallback || setTimeout)(check, { timeout: 2000 }); }
      if (document.readyState === 'complete') idle(); else addEventListener('load', idle);
    });

    window.brgLocal.then(function (isLocal) {
      if (!isLocal) return;
      var els = document.querySelectorAll('[data-local-only]');
      if (!els.length) return;
      // Where a hidden block would appear: the bottom of the nearest earlier
      // sibling that renders a box (skipping scripts and other hidden blocks),
      // else the top of its parent.
      function slotTop(el) {
        for (var prev = el.previousElementSibling; prev; prev = prev.previousElementSibling) {
          if (prev.getClientRects().length) return prev.getBoundingClientRect().bottom;
        }
        return el.parentElement.getBoundingClientRect().top;
      }
      // Reads first, then writes: one layout, one style recalc.
      var fold = window.innerHeight, show = [];
      els.forEach(function (el) {
        if (slotTop(el) >= fold) show.push(el);
      });
      show.forEach(function (el) { el.classList.add('brg-local-show'); });
    });
  </script>

  {# Blue River Live. window.brgLive holds the shared helpers (/live/ uses them
     too). The banner fetches the newest post only after window load, in idle
     time, like GA and brgLocal: nothing runs before the page is interactive.
     It asks for the bare /api/live/feed — the same URL as /live/'s first page —
     so every page shares one cached response (the Function caches per n+cursor
     and Cloudinary's Admin API is rate-limited hourly). On /live/ it reuses the
     page's own response (window.brgLiveFirst) instead of a second request.
     The thumb is the feed's image re-derived at w_200 (≈6KB), never the w_500.
     Times tick every 15s. Only the town is shown: the feed has no coordinates
     and none may ever be added to the page. #}
  <script>
    (function () {
      var DAY = 86400000, fmt = {};
      function dateFmt(withYear) {
        var k = withYear ? 'y' : 'n';
        if (!fmt[k]) {
          var o = { month: 'short', day: 'numeric', timeZone: 'America/Chicago' };
          if (withYear) o.year = 'numeric';
          try { fmt[k] = new Intl.DateTimeFormat('en-US', o); }
          catch (err) { delete o.timeZone; fmt[k] = new Intl.DateTimeFormat('en-US', o); }
        }
        return fmt[k];
      }
      // "Nov 6"; with the year only when it isn't the current one.
      function day(t, now) {
        var d = new Date(t), n = new Date(now == null ? Date.now() : now);
        if (isNaN(d)) return '';
        return dateFmt(d.getFullYear() !== n.getFullYear()).format(d);
      }
      function rel(t, now) {
        var ts = Date.parse(t);
        if (isNaN(ts)) return '';
        var m = Math.floor(Math.max(0, (now == null ? Date.now() : now) - ts) / 60000);
        if (m < 1) return 'just now';
        if (m < 60) return m + ' min ago';
        var h = Math.floor(m / 60);
        if (h < 24) return h + (h === 1 ? ' hr' : ' hrs') + ' ago';
        var dd = Math.floor(h / 24);
        if (dd < 7) return dd + (dd === 1 ? ' day' : ' days') + ' ago';
        return day(ts, now);
      }
      function isLive(t, now) { return (now == null ? Date.now() : now) - Date.parse(t) < DAY; }
      // Only https (or same-site) URLs from the feed ever reach src/href.
      function safe(u) { return typeof u === 'string' && (/^https:\/\//i.test(u) || /^\/(?!\/)/.test(u)) ? u : ''; }
      // Cloudinary thumb -> the small variant: drop the feed's own transforms
      // (c_limit,w_500,…), keep v<version>/<public_id>, use w_200,f_auto,q_auto.
      // Other hosts pass through unchanged.
      function small(u) {
        var m = /^(https:\/\/res\.cloudinary\.com\/[^/]+\/image\/upload\/)(.+)$/.exec(safe(u));
        if (!m) return safe(u);
        var parts = m[2].split('/');
        while (parts.length > 1 && /^[a-z]{1,3}_[^,]+(,[a-z]{1,3}_[^,]+)*$/.test(parts[0])) parts.shift();
        return m[1] + 'w_200,f_auto,q_auto/' + parts.join('/');
      }
      function el(tag, cls, text) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text != null) e.textContent = text;
        return e;
      }
      function dot(on) { return el('span', 'live-dot' + (on ? ' is-live' : '')); }
      function ago(t, now) {
        var e = el('time', null, rel(t, now));
        e.setAttribute('datetime', t);
        e.setAttribute('data-posted', t);
        return e;
      }
      var reduced = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
      // Re-render every posted time (and LIVE state) against `now`. A time
      // marked .lb-time (banner concept b) gives a small pop when it changes.
      function tick(now) {
        now = now == null ? Date.now() : now;
        var ts = document.querySelectorAll('[data-posted]');
        for (var i = 0; i < ts.length; i++) {
          var t = ts[i].getAttribute('data-posted'), s = rel(t, now);
          if (ts[i].textContent !== s) {
            ts[i].textContent = s;
            if (!reduced && ts[i].classList.contains('lb-time') && ts[i].animate) ts[i].animate([{ transform: 'scale(1.18)', opacity: 0.6 }, { transform: 'none', opacity: 1 }], { duration: 420, easing: 'ease-out' });
          }
          var box = ts[i].closest('[data-live-box]');
          if (box && box.setLive) box.setLive(isLive(t, now));
        }
      }
      var ticking = false;
      function startTicking() {
        if (ticking) return; ticking = true;
        setInterval(function () { if (!document.hidden) tick(); }, 15000);
        document.addEventListener('visibilitychange', function () { if (!document.hidden) tick(); });
      }
      // A post's first photo. Batches carry photos[]; the pre-batch feed had
      // w/h/thumb/full on the post itself.
      function first(p) { return (p && p.photos && p.photos[0]) || p || {}; }
      function ok(p) { return p && !isNaN(Date.parse(p.posted_at)); }
      window.brgLive = { rel: rel, day: day, isLive: isLive, safe: safe, small: small, el: el, dot: dot, ago: ago, tick: tick, startTicking: startTicking, first: first, reduced: reduced };

      var slot = document.getElementById('live-banner');
      if (!slot) return;
      slot.addEventListener('click', function (e) {
        if (e.target.closest && e.target.closest('a') && window.brgTrack) brgTrack('live_banner_click');
      });
      function thumb(p, size) {
        var src = small(first(p).thumb);
        if (!src) return null;
        var img = el('img', 'live-banner-thumb');
        img.alt = ''; img.width = size; img.height = size; img.decoding = 'async';
        img.src = src;
        return img;
      }
      // Today's banner (no data-variant): the link's contents are swapped in place.
      function renderPlain(p) {
        var a = slot.querySelector('a'), frag = document.createDocumentFragment(), img = thumb(p, 28);
        if (img) frag.appendChild(img);
        var d0 = dot(isLive(p.posted_at));
        frag.appendChild(d0);
        var txt = el('span', 'live-banner-text');
        txt.appendChild(el('strong', 'live-banner-tag', 'LIVE'));
        txt.appendChild(document.createTextNode(' · posted '));
        txt.appendChild(ago(p.posted_at));
        if (p.town) txt.appendChild(document.createTextNode(' · ' + p.town));
        txt.appendChild(el('span', 'live-banner-arrow', ' →'));
        frag.appendChild(txt);
        a.setAttribute('data-live-box', '');
        a.setLive = function (on) { d0.classList.toggle('is-live', on); };
        a.textContent = '';
        a.appendChild(frag);
        startTicking();
      }

      // Motion concepts (data-variant a|b|c), for Micaiah to pick from. Every
      // new layer is absolutely positioned inside the fixed 40px slot and
      // moves by transform/opacity only, so nothing outside the slot can
      // shift. The static label stays until the new layer is in, then leaves.
      // Reduced motion: an opacity fade; no slides, flips or cycling.
      //   a  photo card slides in from the right and settles
      //   b  breaking-news strip: band wipes in from the left, LIVE tab, the
      //      ticking time in a chip that pops on each change
      //   c  departure board: flips to the newest job, once through the next
      //      two, and rests back on the newest
      function item(v, p) {
        var it = el('span', 'lb-item'), d0 = dot(isLive(p.posted_at));
        it.setAttribute('data-live-box', '');
        it.setLive = function (on) { d0.classList.toggle('is-live', on); };
        var img = thumb(p, v === 'a' ? 30 : 26), t = ago(p.posted_at);
        if (v === 'a') {
          it.appendChild(el('span', 'lb-brand', 'Blue River Live'));
          var card = el('span', 'lb-card');
          if (img) card.appendChild(img);
          card.appendChild(d0);
          card.appendChild(el('strong', 'lb-tag', 'LIVE'));
          var tx = el('span', 'lb-text');
          tx.appendChild(document.createTextNode('posted '));
          tx.appendChild(t);
          if (p.town) tx.appendChild(document.createTextNode(' · ' + p.town));
          card.appendChild(tx);
          card.appendChild(el('span', 'lb-arrow', '→'));
          it.appendChild(card);
        } else if (v === 'b') {
          var tab = el('span', 'lb-tab');
          tab.appendChild(d0);
          tab.appendChild(el('strong', null, 'LIVE'));
          it.appendChild(el('span', 'lb-wipe'));
          it.appendChild(tab);
          var row = el('span', 'lb-row');
          if (img) row.appendChild(img);
          row.appendChild(el('span', 'lb-brand', 'Blue River Live'));
          if (p.town) row.appendChild(el('span', 'lb-town', p.town));
          t.className = 'lb-time';
          var chip = el('span', 'lb-chip', 'posted ');
          chip.appendChild(t);
          row.appendChild(chip);
          row.appendChild(el('span', 'lb-arrow', '→'));
          it.appendChild(row);
        } else {
          var face = el('span', 'lb-face');
          face.appendChild(el('span', 'lb-brand', 'Blue River Live'));
          if (img) face.appendChild(img);
          face.appendChild(d0);
          if (p.town) face.appendChild(el('span', 'lb-town', p.town));
          var c = el('span', 'lb-when');
          c.appendChild(t);
          face.appendChild(c);
          face.appendChild(el('span', 'lb-arrow', '→'));
          it.appendChild(face);
        }
        return it;
      }
      function whenReady(it, fn) {
        // Start the motion once the thumb can paint (or after 1.2s regardless).
        var img = it.querySelector('img'), done = false;
        function go() { if (!done) { done = true; fn(); } }
        if (img && img.decode) img.decode().then(go, go); else go();
        setTimeout(go, 1200);
      }
      function renderVariant(v, posts) {
        var a = slot.querySelector('a'), label = a.textContent;
        var stage = el('span', 'lb-stage'), st = el('span', 'lb-static', label);
        var cur = item(v, posts[0]);
        cur.classList.add('lb-current');
        slot.classList.add('live-banner--' + v);
        a.textContent = '';
        a.appendChild(st);
        a.appendChild(stage);
        whenReady(cur, function () {
          stage.appendChild(cur);
          cur.classList.add('lb-in');
          st.classList.add('lb-out');
          setTimeout(function () { if (st.parentNode) st.parentNode.removeChild(st); }, 900);
          startTicking();
          if (v === 'c' && !reduced && posts.length > 1) cycle(stage, posts);
        });
      }
      // Concept c: one pass through the next two posts, back to the newest, then rest.
      // Holds while hovered/focused, scrolled away or in a background tab.
      function cycle(stage, posts) {
        var order = posts.slice(1, 3).concat([posts[0]]), every = +slot.getAttribute('data-cycle-ms') || 4500, i = 0, hold = false, seen = true;
        slot.addEventListener('mouseenter', function () { hold = true; });
        slot.addEventListener('mouseleave', function () { hold = false; });
        slot.addEventListener('focusin', function () { hold = true; });
        slot.addEventListener('focusout', function () { hold = false; });
        if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { seen = es[0].isIntersecting; }).observe(slot);
        function step() {
          if (i >= order.length) return;
          if (hold || !seen || document.hidden) return setTimeout(step, every);
          var next = item('c', order[i++]), old = stage.querySelector('.lb-current');
          whenReady(next, function () {
            old.classList.remove('lb-current', 'lb-in');
            old.classList.add('lb-flip-out');
            next.classList.add('lb-current', 'lb-in');
            stage.appendChild(next);
            setTimeout(function () { if (old.parentNode) old.parentNode.removeChild(old); }, 700);
            setTimeout(step, every);
          });
        }
        setTimeout(step, every);
      }
      function render(d) {
        var posts = ((d && d.posts) || []).filter(ok);
        if (!posts.length) return;
        var v = slot.getAttribute('data-variant') || '';
        if (/^[abc]$/.test(v)) renderVariant(v, posts.slice(0, 3)); else renderPlain(posts[0]);
      }
      function hydrate() {
        (window.brgLiveFirst || fetch('/api/live/feed', { headers: { accept: 'application/json' } })
          .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }))
          .then(render)
          .catch(function () { /* the static "Blue River Live →" link stays */ });
      }
      function idle() { (window.requestIdleCallback || setTimeout)(hydrate, { timeout: 2000 }); }
      if (document.readyState === 'complete') idle(); else addEventListener('load', idle);
    })();
  </script>

  {# Additional scripts slot #}
  {% block scripts %}{% endblock %}
  
</body>
</html>
