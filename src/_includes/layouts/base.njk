<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Blue River Gutters | North Alabama Gutter Services") }}</title>
  <meta name="description" content="{{ meta_description | default(description) | default("Professional gutter installation, repair, and cleaning in Huntsville, Madison, Decatur, and throughout North Alabama. 20+ years experience.") }}">
  
  {# Favicon #}
  <link rel="icon" type="image/jpeg" sizes="60x60" href="https://res.cloudinary.com/dxzw1zwez/image/upload/Favicon_edited_vk3gls.jpg">
  
  {# LCP hero preload — must come BEFORE other resource hints.
     The hero is a CSS background, so the browser can't discover it until the
     stylesheet is parsed. Paired media preloads match the .rsp-bg
     768px breakpoint in main.css, so each device fetches only the variant it
     will paint. Pages set lcp_hero (+ lcp_hero_crop) in frontmatter; article,
     city and service layouts derive it from hero_kind + hero_image. #}
  {% set lcpHero = lcp_hero %}
  {% set lcpCrop = lcp_hero_crop | default(hero_crop) | default('tall') %}
  {% if not lcpHero %}
    {% if hero_kind == 'article' %}{% set lcpHero = hero_image | default(heroes.article) %}
    {% elif hero_kind == 'city' %}{% set lcpHero = hero_image | default(heroes.city) %}
    {% elif hero_kind == 'service' %}{% set lcpHero = hero_image | default(heroes.services[service_slug] | default(heroes.service)) %}
    {% endif %}
  {% endif %}
  {% if lcpHero %}
  <link rel="preload" as="image" fetchpriority="high" href="{{ lcpHero | mobileBg(lcpCrop) }}" media="(max-width: 768px)">
  <link rel="preload" as="image" fetchpriority="high" href="{{ lcpHero }}" media="(min-width: 769px)">
  {% endif %}
  
  {# Google Analytics #}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GT8EBK75TK"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GT8EBK75TK');
  </script>
  
  {# Microsoft Clarity - heatmaps & session recordings (project: wxpmxnmcqn) #}
  {% raw %}
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wxpmxnmcqn");
  </script>
  {% endraw %}

  {# Clarity custom events — phone clicks + form starts.
     Every call goes through brgTrack, which no-ops if Clarity is blocked,
     ad-filtered, or simply hasn't loaded yet. Never call clarity() bare. #}
  {% raw %}
  <script>
    (function () {
      function brgTrack(name) {
        try {
          if (window.clarity) window.clarity('event', name);
        } catch (err) { /* analytics must never break the page */ }
      }
      window.brgTrack = brgTrack;

      // Phone clicks, delegated from document so it covers the hero, both
      // sticky bars, inline CTA boxes, headers, footers — and anything added
      // later — without needing to be re-wired. Capture phase so a handler
      // that stops propagation can't swallow it.
      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || typeof t.closest !== 'function') return;
        if (t.closest('a[href^="tel:"]')) brgTrack('phone_click');
      }, true);

      // Form starts: first focus into either lead form, once per page load.
      document.addEventListener('DOMContentLoaded', function () {
        var forms = [
          ['lead-form', 'form_start_homepage'],
          ['contact-form', 'form_start_contact']
        ];
        forms.forEach(function (pair) {
          var el = document.getElementById(pair[0]);
          if (!el) return;
          el.addEventListener('focusin', function () { brgTrack(pair[1]); }, { once: true });
        });
      });
    })();
  </script>
  {% endraw %}
  
  {# Open Graph #}
  <meta property="og:title" content="{{ title | default("Blue River Gutters") }}">
  <meta property="og:description" content="{{ meta_description | default(description) | default("Professional gutter services in North Alabama.") }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://bluerivergutters.com{{ page.url }}">
  <meta property="og:image" content="{{ ogImage | default("https://res.cloudinary.com/dxzw1zwez/image/upload/hero-bg_axhlw4.jpg") }}">
  
  {# Fonts - Source Sans 3, self-hosted (variable 400–700, @font-face in main.css).
     Preloading the latin file lets it download in parallel with main.css
     instead of waiting for the stylesheet to be parsed. #}
  <link rel="preload" as="font" type="font/woff2" href="{{ '/fonts/source-sans-3-latin.woff2' | url }}" crossorigin>
  
  {# Combined Stylesheet (styles + navigation + parallax merged for perf) #}
  <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
  {% if extraCss %}
  <link rel="stylesheet" href="{{ '/css/' | url }}{{ extraCss }}">
  {% endif %}
  
  {# Canonical URL #}
  <link rel="canonical" href="https://bluerivergutters.com{{ page.url }}">
  
  {# Schema markup slot #}
  {% block schema %}{% endblock %}
</head>
<body>
  
  {% include "partials/header.njk" %}
  
  <main>
    {% block content %}
    {{ content | safe }}
    {% endblock %}
  </main>
  
  {% include "partials/footer.njk" %}
  
  {# Navigation JS (dropdowns, mobile menu, accordions) #}
  <script src="{{ '/js/navigation.js' | url }}"></script>
  
  {# FAQ accordion #}
  <script>
    document.querySelectorAll('.faq-question').forEach(button => {
      button.addEventListener('click', () => {
        const faqItem = button.parentElement;
        const isOpen = faqItem.classList.contains('active');
        
        // Close all
        document.querySelectorAll('.faq-item').forEach(item => {
          item.classList.remove('active');
        });
        
        // Open clicked if it was closed
        if (!isOpen) {
          faqItem.classList.add('active');
        }
      });
    });
  </script>
  
  {# Animated stat counter #}
  <script>
    (function() {
      const counters = document.querySelectorAll('.stat-number');
      if (!counters.length) return;
      
      let animated = false;
      
      function animateCounter(el) {
        const text = el.textContent;
        // Extract number and any suffix (like +, ★, ", etc)
        const match = text.match(/^([\d,]+)(.*)/);
        if (!match) return;
        
        const target = parseInt(match[1].replace(/,/g, ''));
        const suffix = match[2] || '';
        const duration = 1500;
        const start = performance.now();
        
        function update(now) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          // Ease out cubic
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = Math.floor(target * eased);
          
          // Format with commas
          el.textContent = current.toLocaleString() + suffix;
          
          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            el.textContent = target.toLocaleString() + suffix;
          }
        }
        
        requestAnimationFrame(update);
      }
      
      function checkVisibility() {
        if (animated) return;
        
        const statsSection = document.querySelector('.stats-section');
        if (!statsSection) return;
        
        const rect = statsSection.getBoundingClientRect();
        const isVisible = rect.top < window.innerHeight * 0.8 && rect.bottom > 0;
        
        if (isVisible) {
          animated = true;
          counters.forEach(counter => animateCounter(counter));
        }
      }
      
      // Use Intersection Observer if available
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !animated) {
              animated = true;
              counters.forEach(counter => animateCounter(counter));
              observer.disconnect();
            }
          });
        }, { threshold: 0.3 });
        
        const statsSection = document.querySelector('.stats-section');
        if (statsSection) observer.observe(statsSection);
      } else {
        // Fallback for older browsers
        window.addEventListener('scroll', checkVisibility);
        checkVisibility();
      }
    })();
  </script>
  
  {# Additional scripts slot #}
  {% block scripts %}{% endblock %}
  
</body>
</html>
