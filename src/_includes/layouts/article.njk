---
layout: base.njk
extraCss: article.css
---

{# Schema Markup #}
{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "image": "{{ hero_image | default('https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1200/bluerivergutters/corner_of_a_roof_gutters_yd8zzf.jpg') }}",
  "author": {
    "@type": "Organization",
    "name": "Blue River Gutters",
    "url": "https://bluerivergutters.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Blue River Gutters",
    "logo": {
      "@type": "ImageObject",
      "url": "https://res.cloudinary.com/dxzw1zwez/image/upload/logo_fih2rm.webp"
    }
  },
  "datePublished": "{{ publish_date | default('2026-01-30') }}",
  "dateModified": "{{ modified_date | default(publish_date) | default('2026-01-30') }}"
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bluerivergutters.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Articles",
      "item": "https://bluerivergutters.com/articles/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ title }}",
      "item": "https://bluerivergutters.com{{ page.url }}"
    }
  ]
}
</script>
{% endblock %}

{# Breadcrumbs #}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol class="breadcrumb-list">
      <li><a href="{{ '/' | url }}">Home</a></li>
      <li><a href="{{ '/articles/' | url }}">Articles</a></li>
      <li aria-current="page">{{ breadcrumb_title | default(title) }}</li>
    </ol>
  </div>
</nav>

{# Article Hero #}
<section class="article-hero" style="background-image: url('{{ hero_image | default('https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/bluerivergutters/corner_of_a_roof_gutters_yd8zzf.jpg') }}');">
  <div class="article-hero-overlay"></div>
  <div class="container">
    <div class="article-hero-content">
      {% if category %}
      <span class="article-category">{{ category }}</span>
      {% endif %}
      <h1>{{ headline | default(title) }}</h1>
      {% if subtitle %}
      <p class="article-subtitle">{{ subtitle }}</p>
      {% endif %}
      <div class="article-meta">
        {% if read_time %}<span class="read-time">📖 {{ read_time }} min read</span>{% endif %}
        {% if publish_date %}<span class="publish-date">{{ publish_date }}</span>{% endif %}
      </div>
    </div>
  </div>
</section>

{# Article Body #}
<article class="article-body">
  <div class="container container--article">
    
    {# Optional Key Takeaways Box #}
    {% if takeaways %}
    <aside class="article-takeaways">
      <h4>Key Takeaways</h4>
      <ul>
        {% for item in takeaways %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </aside>
    {% endif %}
    
    {# Main Content #}
    <div class="article-content">
      {{ content | safe }}
    </div>
    
    {# Author Box #}
    <div class="article-author-box">
      <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_80/bluerivergutters/logo_fih2rm.webp" alt="Blue River Gutters" class="author-avatar">
      <div class="author-info">
        <p class="author-name">Blue River Gutters</p>
        <p class="author-bio">Serving North Alabama since 2003. Over 20 years of experience protecting homes from water damage with quality gutter installation, repair, and maintenance.</p>
      </div>
    </div>
    
  </div>
</article>

{# Related Services #}
{% if related_city %}
<section class="article-related">
  <div class="container">
    <h2>Gutter Services in {{ related_city }}</h2>
    <p>Need help with your gutters? We serve {{ related_city }} and surrounding areas.</p>
    <div class="related-links">
      <a href="{{ '/gutters-' + related_city_slug + '-al/' | url }}" class="btn btn-dark">{{ related_city }} Services</a>
      <a href="tel:2566166760" class="btn btn-primary">📞 (256) 616-6760</a>
    </div>
  </div>
</section>
{% endif %}

{# CTA Section #}
<section class="cta">
  <div class="container">
    <h2>{{ cta_headline | default('Ready to Protect Your Home?') }}</h2>
    <p>{{ cta_text | default('Get a free estimate from North Alabama\'s trusted gutter experts.') }}</p>
    <a href="https://BlueRiverGutters.as.me/" class="btn btn-primary">Schedule Free Estimate</a>
    <p class="cta-phone"><a href="tel:2566166760">📞 (256) 616-6760</a></p>
  </div>
</section>
