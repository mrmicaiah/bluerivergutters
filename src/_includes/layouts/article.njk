---
layout: base.njk
extraCss: article.css
---

{# Schema Markup #}
{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "image": "{{ hero_image | default('https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1200/corner_of_a_roof_gutters_yd8zzf.jpg') }}",
  "author": {
    "@type": "Organization",
    "name": "Blue River Gutters",
    "url": "https://bluerivergutters.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Blue River Gutters",
    "logo": {
      "@type": "ImageObject",
      "url": "https://res.cloudinary.com/dxzw1zwez/image/upload/logo_fih2rm.webp"
    }
  },
  "datePublished": "{{ date_published | default('2026-01-30') }}",
  "dateModified": "{{ date_modified | default(date_published) | default('2026-01-30') }}"
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bluerivergutters.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Articles",
      "item": "https://bluerivergutters.com/articles/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ title }}",
      "item": "https://bluerivergutters.com{{ page.url }}"
    }
  ]
}
</script>
{% endblock %}

{# Breadcrumbs #}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol class="breadcrumb-list">
      <li><a href="{{ '/' | url }}">Home</a></li>
      <li><a href="{{ '/articles/' | url }}">Articles</a></li>
      <li aria-current="page">{{ breadcrumb_title | default(title) }}</li>
    </ol>
  </div>
</nav>

{# Article Hero #}
<section class="article-hero" style="background-image: url('{{ hero_image | default('https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/corner_of_a_roof_gutters_yd8zzf.jpg') }}');">
  <div class="article-hero-overlay"></div>
  <div class="container">
    <div class="article-hero-content">
      {% if category %}
      <span class="article-category">{{ category }}</span>
      {% endif %}
      <h1>{{ headline | default(title) }}</h1>
      {% if subtitle %}
      <p class="article-subtitle">{{ subtitle }}</p>
      {% endif %}
      <div class="article-meta">
        {% if read_time %}<span class="read-time">📖 {{ read_time }} min read</span>{% endif %}
        {% if date_display %}<span class="publish-date">{{ date_display }}</span>{% endif %}
      </div>
    </div>
  </div>
</section>

{# Article Body #}
<article class="article-body">
  <div class="container container--article">
    
    {# Optional Key Takeaways Box #}
    {% if takeaways %}
    <aside class="article-takeaways">
      <h4>Key Takeaways</h4>
      <ul>
        {% for item in takeaways %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </aside>
    {% endif %}
    
    {# Main Content #}
    <div class="article-content">
      {{ content | safe }}
    </div>
    
    {# Author Box #}
    <div class="article-author-box">
      <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_80/logo_fih2rm.webp" alt="Blue River Gutters" class="author-avatar">
      <div class="author-info">
        <p class="author-name">Blue River Gutters</p>
        <p class="author-bio">Serving North Alabama since 2003. Over 20 years of experience protecting homes from water damage with quality gutter installation, repair, and maintenance.</p>
      </div>
    </div>
    
  </div>
</article>

{# Related Content #}
<section class="article-related">
  <div class="container">
    <div class="article-related-grid">
      
      {# City Services #}
      {% if related_city %}
      <div class="article-related-block">
        <h3>Gutter Services in {{ related_city }}</h3>
        <ul class="article-services-list">
          <li><a href="{{ '/services/' + related_city_slug + '/seamless-gutters/' | url }}">Seamless Gutters</a></li>
          <li><a href="{{ '/services/' + related_city_slug + '/gutter-guards/' | url }}">Gutter Guards</a></li>
          <li><a href="{{ '/services/' + related_city_slug + '/gutter-cleaning/' | url }}">Gutter Cleaning</a></li>
          <li><a href="{{ '/services/' + related_city_slug + '/downspouts/' | url }}">Downspouts</a></li>
          <li><a href="{{ '/services/' + related_city_slug + '/underground-drains/' | url }}">Underground Drains</a></li>
          <li><a href="{{ '/services/' + related_city_slug + '/rotten-wood-repair/' | url }}">Rotten Wood Repair</a></li>
        </ul>
        <a href="{{ '/gutters-' + related_city_slug + '-al/' | url }}" class="btn btn-dark">View All {{ related_city }} Services</a>
      </div>
      {% endif %}
      
      {# Related Blog Posts #}
      <div class="article-related-block">
        <h3>From Our Blog</h3>
        <ul class="article-blog-list">
          <li><a href="{{ '/blog/red-clay-soil-drainage-alabama/' | url }}">The Red Clay Problem</a></li>
          <li><a href="{{ '/blog/seasonal-gutter-maintenance-guide-alabama/' | url }}">Seasonal Maintenance Guide</a></li>
          <li><a href="{{ '/blog/gutter-cost-north-alabama-2026/' | url }}">2026 Pricing Guide</a></li>
        </ul>
        <a href="{{ '/blog/' | url }}" class="btn btn-outline">View All Blog Posts</a>
      </div>
      
    </div>
  </div>
</section>

{# CTA Section #}
<section class="cta">
  <div class="container">
    <h2>{{ cta_headline | default('Ready to Protect Your Home?') }}</h2>
    <p>{{ cta_text | default('Get a free estimate from North Alabama\'s trusted gutter experts.') }}</p>
    <a href="https://BlueRiverGutters.as.me/" class="btn btn-primary">Schedule Free Estimate</a>
    <p class="cta-phone"><a href="tel:2566166760">📞 (256) 616-6760</a></p>
  </div>
</section>
