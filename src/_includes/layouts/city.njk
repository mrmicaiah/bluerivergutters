---
layout: base.njk
extraCss: city-pages.css
---

{# Schema Markup #}
{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Blue River Gutters",
  "image": "https://res.cloudinary.com/dxzw1zwez/image/upload/logo_fih2rm.webp",
  "@id": "https://bluerivergutters.com/",
  "url": "https://bluerivergutters.com/gutters-{{ city_slug }}-al/",
  "telephone": "+1-256-616-6760",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "3315 Memorial Pkwy SW, Suite B13",
    "addressLocality": "Huntsville",
    "addressRegion": "AL",
    "postalCode": "35801",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 34.7304,
    "longitude": -86.5861
  },
  "areaServed": {
    "@type": "City",
    "name": "{{ city }}, Alabama"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "08:00",
    "closes": "17:00"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.7",
    "reviewCount": "240"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bluerivergutters.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Locations",
      "item": "https://bluerivergutters.com/locations/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ city }}, AL",
      "item": "https://bluerivergutters.com/gutters-{{ city_slug }}-al/"
    }
  ]
}
</script>

{% if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqs %}{
      "@type": "Question",
      "name": "{{ faq.question | striptags }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ faq.answer | striptags | trim }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
{% endblock %}

{# Breadcrumbs #}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol class="breadcrumb-list">
      <li><a href="{{ '/' | url }}">Home</a></li>
      <li><a href="{{ '/locations/' | url }}">Locations</a></li>
      <li aria-current="page">{{ city }}, AL</li>
    </ol>
  </div>
</nav>

{# Hero Section - Uses corner_of_a_roof_gutters as default for city pages #}
<section class="hero" style="background-image: url('{{ hero_image | default("https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/bluerivergutters/corner_of_a_roof_gutters_yd8zzf.jpg") }}');">
  <div class="hero-overlay"></div>
  <div class="container hero-container">
    <div class="hero-content">
      <p class="hero-eyebrow">{{ hero_eyebrow | default("Proudly Serving " + city + ", Alabama") }}</p>
      <h1>{{ hero_headline | default(city + "'s Trusted Gutter Experts") }}</h1>
      
      <p>{{ local_hook }}</p>
      
      <div class="hero-cta">
        <a href="tel:2566166760" class="btn btn-primary">📞 CALL (256) 616-6760</a>
        <a href="https://BlueRiverGutters.as.me/" class="btn btn-secondary">✉️ Get Free Estimate</a>
      </div>
    </div>
  </div>
</section>

{# Trust Indicators / Stats #}
<section class="stats-section">
  <div class="container">
    <div class="stats">
      <div class="stat">
        <div class="stat-number">20+</div>
        <div class="stat-label">Years Experience</div>
      </div>
      <div class="stat">
        <div class="stat-number">1,700+</div>
        <div class="stat-label">Happy Customers</div>
      </div>
      <div class="stat">
        <div class="stat-number">4.7★</div>
        <div class="stat-label">Google Rating</div>
      </div>
      <div class="stat">
        <div class="stat-number">{{ distance | default("15") }} min</div>
        <div class="stat-label">From {{ city }}</div>
      </div>
    </div>
  </div>
</section>

{# Local Problems Section #}
<section class="local-problems">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">Local Expertise</p>
      <h2>Why {{ city }} Homes Need Quality Gutters</h2>
    </div>
    
    <div class="local-content">
      {{ local_problems | safe }}
    </div>
  </div>
</section>

{# Services Grid #}
<section class="services" id="services">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">What We Offer</p>
      <h2>Gutter Services in {{ city }}, AL</h2>
      <p class="section-intro">From new installations to repairs and maintenance, Blue River Gutters has {{ city }} covered.</p>
    </div>
    
    <div class="services-grid">
      
      {# Seamless Gutters #}
      <div class="service-card">
        <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_400/bluerivergutters/service-seamless-gutters_hcf6si.webp" alt="Seamless Gutter Installation in {{ city }}" loading="lazy">
        <div class="service-card-content">
          <h3>Seamless Gutters</h3>
          <p>Custom-fabricated on-site for a perfect fit. No seams means fewer leaks and less maintenance for your {{ city }} home.</p>
          <a href="{{ '/services/' + city_slug + '/seamless-gutters/' | url }}" class="btn btn-dark">Learn More</a>
        </div>
      </div>
      
      {# Gutter Guards #}
      <div class="service-card">
        <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_400/bluerivergutters/service-gutter-guards_csf0zo.webp" alt="Gutter Guard Installation in {{ city }}" loading="lazy">
        <div class="service-card-content">
          <h3>Gutter Guards</h3>
          <p>Keep pine needles, oak leaves, and debris out of your gutters. Essential for {{ city }}'s tree-lined neighborhoods.</p>
          <a href="{{ '/services/' + city_slug + '/gutter-guards/' | url }}" class="btn btn-dark">Learn More</a>
        </div>
      </div>
      
      {# Gutter Cleaning #}
      <div class="service-card">
        <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_400/bluerivergutters/service-gutter-cleaning_kqfwes.webp" alt="Gutter Cleaning Services in {{ city }}" loading="lazy">
        <div class="service-card-content">
          <h3>Gutter Cleaning</h3>
          <p>Professional cleaning inside and out. We clear clogs, flush downspouts, and inspect for damage — so you don't have to climb that ladder.</p>
          <a href="{{ '/services/' + city_slug + '/gutter-cleaning/' | url }}" class="btn btn-dark">Learn More</a>
        </div>
      </div>
      
      {# Downspouts #}
      <div class="service-card">
        <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_400/bluerivergutters/service-downspouts_iqkukv.webp" alt="Downspout Installation in {{ city }}" loading="lazy">
        <div class="service-card-content">
          <h3>Downspouts</h3>
          <p>Properly sized and positioned downspouts ensure water flows away from your foundation — critical for {{ city }}'s clay soil.</p>
          <a href="{{ '/services/' + city_slug + '/downspouts/' | url }}" class="btn btn-dark">Learn More</a>
        </div>
      </div>
      
      {# Underground Drains #}
      <div class="service-card">
        <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_400/bluerivergutters/service-underground-drains_sbbgru.webp" alt="Underground Drainage in {{ city }}" loading="lazy">
        <div class="service-card-content">
          <h3>Underground Drains</h3>
          <p>Route water far from your foundation with buried drainage systems. The ultimate solution for {{ city }}'s drainage challenges.</p>
          <a href="{{ '/services/' + city_slug + '/underground-drains/' | url }}" class="btn btn-dark">Learn More</a>
        </div>
      </div>
      
      {# Rotten Wood Repair #}
      <div class="service-card">
        <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_400/bluerivergutters/service-rotten-wood_jhfmim.webp" alt="Fascia and Rotten Wood Repair in {{ city }}" loading="lazy">
        <div class="service-card-content">
          <h3>Rotten Wood Repair</h3>
          <p>Alabama humidity accelerates wood rot. We repair fascia and soffit damage before installing new gutters.</p>
          <a href="{{ '/services/' + city_slug + '/rotten-wood-repair/' | url }}" class="btn btn-dark">Learn More</a>
        </div>
      </div>
      
    </div>
  </div>
</section>

{# Why Local Matters #}
<section class="why-local">
  <div class="container">
    <div class="why-local-grid">
      <div class="why-local-content">
        <p class="section-eyebrow">Your {{ city }} Neighbor</p>
        <h2>Why {{ city }} Homeowners Choose Blue River Gutters</h2>
        
        {{ why_local | safe | default("<p>We're not a franchise from out of state — we're your neighbors. Our office is right here in Huntsville, and we've been serving North Alabama for over two decades. When you call Blue River Gutters, you're talking to someone who knows the area and can be at your door quickly if you have an emergency.</p>") }}
        
        <ul class="checkmarks">
          <li>✓ Headquartered in Huntsville — not a franchise</li>
          <li>✓ 20+ years serving North Alabama</li>
          <li>✓ All work performed by our trained employees</li>
          <li>✓ Same-day emergency response available</li>
          <li>✓ We understand {{ city }}'s unique drainage challenges</li>
          <li>✓ Licensed, insured, and warranty-backed</li>
        </ul>
        
        <div class="why-local-cta">
          <a href="tel:2566166760" class="btn btn-primary">📞 CALL (256) 616-6760</a>
        </div>
      </div>
      
      <div class="why-local-image">
        <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_600/bluerivergutters/cleaning_composite_facia_ekqfke.webp" alt="Blue River Gutters quality workmanship in {{ city }}" loading="lazy">
      </div>
    </div>
  </div>
</section>

{# Neighborhoods Section #}
{% if neighborhoods %}
<section class="neighborhoods">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">Serving All of {{ city }}</p>
      <h2>Gutter Services Throughout {{ county | default(city) }} County</h2>
    </div>
    
    <div class="neighborhoods-content">
      <p>Blue River Gutters serves homeowners across every {{ city }} neighborhood and throughout the county. Whether you live in an established area or a growing community, we're just minutes away.</p>
      
      <div class="neighborhoods-grid">
        {% for group in neighborhoods %}
        <div class="neighborhood-group">
          <h3>{{ group.name }}</h3>
          <ul>
            {% for area in group.areas %}
            <li>{{ area }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
      
      <p class="neighborhoods-note">Don't see your neighborhood? We serve the entire area. Give us a call!</p>
    </div>
  </div>
</section>
{% endif %}

{# Testimonials #}
{% if testimonials %}
<section class="testimonials">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">What Our Customers Say</p>
      <h2>Trusted by {{ city }} Homeowners</h2>
    </div>
    
    <div class="testimonial-grid">
      {% for testimonial in testimonials %}
      <div class="testimonial-card">
        <div class="testimonial-stars">★★★★★</div>
        <p class="testimonial-text">"{{ testimonial.text }}"</p>
        <p class="testimonial-author">— {{ testimonial.author }}, {{ testimonial.location | default(city) }}</p>
      </div>
      {% endfor %}
    </div>
    
    <div class="review-cta">
      <p>See all our reviews on <a href="https://g.co/kgs/oHV77L" target="_blank" rel="noopener">Google</a> (240+ reviews, 4.7★)</p>
    </div>
  </div>
</section>
{% endif %}

{# FAQ Section #}
{% if faqs %}
<section class="faq">
  <div class="container">
    <div class="section-header">
      <h2>Frequently Asked Questions</h2>
      <p>Common questions about gutter services in {{ city }}, AL</p>
    </div>
    
    <div class="faq-list">
      {% for faq in faqs %}
      <div class="faq-item">
        <button class="faq-question">
          <span>{{ faq.question }}</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          {{ faq.answer | safe }}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# Final CTA #}
<section class="cta" id="contact">
  <div class="container">
    <h2>Ready to Protect Your {{ city }} Home?</h2>
    <p>Get a free estimate from North Alabama's trusted gutter experts — your neighbors since 2003.</p>
    <a href="https://BlueRiverGutters.as.me/" class="btn btn-primary">Schedule Free Estimate</a>
    <p class="cta-phone"><a href="tel:2566166760">📞 (256) 616-6760</a></p>
    <p class="cta-hours">MON-FRI 8:00AM-5:00PM</p>
    <p class="cta-address">📍 3315 Memorial Pkwy SW, Suite B13, Huntsville, AL 35801</p>
  </div>
</section>
