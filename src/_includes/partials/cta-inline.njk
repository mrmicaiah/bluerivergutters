{# ===========================================================================
   Inline conversion CTA — compact, self-contained.

   Rendered automatically by layouts/article.njk directly after the Key
   Takeaways block (hits every article at roughly the 20% scroll mark), and
   inserted by hand at a mid-article section break in the highest-traffic
   blog posts. Uses the shared .btn classes and :root CSS vars so it inherits
   the site's design without adding anything to the global stylesheets.
   =========================================================================== #}
{# "Local reader" variant: set cta_inline_local = true before the include on
   DIY-research pages whose readers mostly aren't shopping yet.
   Geo-gated: data-local-only is the hook for the brgLocal helper (base.njk).
   main.css hides it until the helper adds .brg-local-show for
   plausibly-local visitors. Don't add a hide rule here, because one keyed
   to anything else outlives the reveal. #}
{% if cta_inline_local %}
<aside class="cta-inline cta-inline--local" data-local-only>
  <p class="cta-inline-copy">
    Reading this from North Alabama? <strong>We do this for a living.</strong>
    Free estimates in <a href="{{ '/locations/' | url }}">Huntsville, Madison, Decatur and 20+ towns</a> — call <a href="tel:2566166760">(256) 616-6760</a>.
  </p>
  <div class="cta-inline-actions">
    <a href="tel:2566166760" class="btn btn-primary cta-inline-btn">Call (256) 616-6760</a>
  </div>
  {% include "partials/photo-offer-channel.njk" %}
</aside>
{% else %}
<aside class="cta-inline">
  <p class="cta-inline-copy">
    Gutter problems in Huntsville or North Alabama?
    <strong>Free inspection — most homes seen within 48 hours.</strong>
  </p>
  <div class="cta-inline-actions">
    <a href="tel:2566166760" class="btn btn-primary cta-inline-btn">Call (256) 616-6760</a>
    <a href="https://BlueRiverGutters.as.me/" class="btn btn-dark cta-inline-btn" target="_blank" rel="noopener">Get Free Inspection</a>
  </div>
</aside>
{% endif %}

<style>
.cta-inline {
  background: var(--cream);
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-left: 4px solid var(--red);
  border-radius: 10px;
  padding: 1.5rem 1.75rem;
  margin: 2.5rem 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  flex-wrap: wrap;
}
.cta-inline-photo {
  flex: 1 1 100%;
  margin: 0;
  padding-top: 1rem;
  border-top: 1px dashed rgba(15, 23, 42, 0.15);
  font-size: 0.98rem;
  line-height: 1.5;
  color: var(--slate);
}
.cta-inline-photo a { font-weight: 600; text-decoration: underline; }
.cta-inline-copy {
  margin: 0;
  flex: 1 1 280px;
  min-width: 0;
  font-size: 1.02rem;
  line-height: 1.55;
  color: var(--slate);
}
.cta-inline-copy strong {
  color: var(--navy);
  display: block;
}
.cta-inline-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  flex-shrink: 0;
}
/* When the box sits inside .blog-content / .article-content, their link
   color (0,1,1) beats .btn-primary's white (0,1,0): blue text on red */
.cta-inline .cta-inline-btn,
.cta-inline .cta-inline-btn:hover { color: var(--white); }
.cta-inline .cta-inline-btn {
  padding: 0.8rem 1.4rem;
  font-size: 0.95rem;
  white-space: nowrap;
  text-decoration: none;
}

@media (max-width: 768px) {
  .cta-inline {
    flex-direction: column;
    align-items: stretch;
    padding: 1.25rem 1.25rem 1.4rem;
    gap: 1.1rem;
  }
  .cta-inline-copy { flex: none; font-size: 1rem; }
  .cta-inline-photo { flex: none; }
  .cta-inline-copy strong { display: inline; }
  .cta-inline-actions { flex-direction: column; gap: 0.6rem; }
  .cta-inline .cta-inline-btn {
    width: 100%;
    padding: 0.95rem 1rem;
    font-size: 1rem;
  }
}
</style>
