
{# Service-specific hero image mapping #}
{# NOTE: Do not include file extensions when using f_auto - Cloudinary handles format negotiation #}
{% set service_hero_images = {
  "seamless-gutters": "https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/corner_of_a_roof_gutters_yd8zzf",
  "gutter-guards": "https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/gutter_guards_metal_roof_hnrqoc",
  "gutter-cleaning": "https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/dirty_gutter_v8f4cm",
  "downspouts": "https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/gutter_on_house_zbvhii",
  "underground-drains": "https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/french_drains_peqnfn",
  "rotten-wood-repair": "https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/rotten_wood_hero_r1dtrh"
} %}
{% set default_hero = "https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_1920/corner_of_a_roof_gutters_yd8zzf" %}
{% set computed_hero = hero_image | default(service_hero_images[service_slug] | default(default_hero)) %}

{# Schema Markup #}
{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ service }} in {{ city }}, {{ state }}",
  "description": "{{ description }}",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Blue River Gutters",
    "image": "https://res.cloudinary.com/dxzw1zwez/image/upload/logo_fih2rm.webp",
    "@id": "https://bluerivergutters.com/",
    "url": "https://bluerivergutters.com/",
    "telephone": "+1-256-616-6760",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "3315 Memorial Pkwy SW, Suite B13",
      "addressLocality": "Huntsville",
      "addressRegion": "AL",
      "postalCode": "35801",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": "{{ city }}, Alabama"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bluerivergutters.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ city }}, AL",
      "item": "https://bluerivergutters.com/gutters-{{ city_slug }}-al/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ service }}",
      "item": "https://bluerivergutters.com/services/{{ city_slug }}/{{ service_slug }}/"
    }
  ]
}
</script>

{% if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqs %}{
      "@type": "Question",
      "name": "{{ faq.question | striptags }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ faq.answer | striptags | trim }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
{% endblock %}

{# Breadcrumbs #}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol class="breadcrumb-list">
      <li><a href="{{ '/' | url }}">Home</a></li>
      {% set city_link = "/gutters-" + city_slug + "-al/" %}
      <li><a href="{{ city_link | url }}">{{ city }}, AL</a></li>
      <li aria-current="page">{{ service }}</li>
    </ol>
  </div>
</nav>

{# Hero Section - Uses service-specific hero images #}
<section class="hero" style="background-image: url('{{ computed_hero }}');">
  <div class="hero-overlay"></div>
  <div class="container hero-container">
    <div class="hero-content">
      <p class="hero-eyebrow">{{ city }}, Alabama</p>
      <h1>{{ hero_headline | default(service + " in " + city + ", AL") }}</h1>
      
      <p>{{ hero_intro }}</p>
      
      <div class="hero-cta">
        <a href="tel:2566166760" class="btn btn-primary">📞 CALL (256) 616-6760</a>
        <a href="https://BlueRiverGutters.as.me/" class="btn btn-secondary">✉️ Get Free Estimate</a>
      </div>
    </div>
  </div>
</section>

{# Trust Indicators / Stats #}
<section class="stats-section">
  <div class="container">
    <div class="stats">
      <div class="stat">
        <div class="stat-number">20+</div>
        <div class="stat-label">Years Experience</div>
      </div>
      <div class="stat">
        <div class="stat-number">1,700+</div>
        <div class="stat-label">Happy Customers</div>
      </div>
      <div class="stat">
        <div class="stat-number">4.7★</div>
        <div class="stat-label">Google Rating</div>
      </div>
      <div class="stat">
        <div class="stat-number">{{ distance | default("15") }} min</div>
        <div class="stat-label">From {{ city }}</div>
      </div>
    </div>
  </div>
</section>

{# Local Problem Hook #}
<section class="local-problems">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">{{ problem_eyebrow | default("The " + city + " Problem") }}</p>
      <h2>{{ problem_headline | default("Why " + city + " Homes Need " + service) }}</h2>
    </div>
    
    <div class="local-content">
      {{ local_problem | safe }}
    </div>
  </div>
</section>

{# Service Explanation #}
<section class="service-explanation">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">{{ explanation_eyebrow | default("The Smart Choice") }}</p>
      <h2>{{ explanation_headline | default("What Are " + service + "?") }}</h2>
    </div>
    
    <div class="explanation-grid">
      <div class="explanation-content">
        {{ service_explanation | safe }}
      </div>
      
      <div class="explanation-image">
        <img src="{{ service_image | default('https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_500/service-seamless-gutters_hcf6si') }}" alt="{{ service }} in {{ city }}" loading="lazy">
      </div>
    </div>
  </div>
</section>

{# Benefits Grid #}
{% if benefits %}
<section class="benefits-section">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">{{ benefits_eyebrow | default("Why Upgrade?") }}</p>
      <h2>{{ benefits_headline | default("Benefits of " + service) }}</h2>
    </div>
    
    <div class="benefits-grid">
      {% for benefit in benefits %}
      <div class="benefit-card">
        <h3>{{ benefit.title }}</h3>
        <p>{{ benefit.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# Why Blue River #}
<section class="why-local">
  <div class="container">
    <div class="why-local-grid">
      <div class="why-local-content">
        <p class="section-eyebrow">Local Experts</p>
        <h2>Why Choose Blue River Gutters in {{ city }}</h2>
        
        {{ why_us | safe | default("<p>We are not a national franchise. We are your neighbors — headquartered just minutes away in Huntsville. When you call Blue River Gutters, you are talking to people who have been serving " + city + " and Madison County for over two decades.</p>") }}
        
        <ul class="checkmarks">
          <li>✓ 20+ years serving North Alabama</li>
          <li>✓ 1,700+ satisfied customers</li>
          <li>✓ 4.7-star Google rating (240+ reviews)</li>
          <li>✓ Licensed and fully insured in Alabama</li>
          <li>✓ Warranty-backed installation</li>
        </ul>
        
        <div class="why-local-cta">
          <a href="tel:2566166760" class="btn btn-primary">📞 CALL (256) 616-6760</a>
        </div>
      </div>
      
      <div class="why-local-image">
        <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/f_auto,q_auto,w_600/cleaning_composite_facia_ekqfke" alt="Blue River Gutters professional installation" loading="lazy">
      </div>
    </div>
  </div>
</section>

{# FAQ Section #}
{% if faqs %}
<section class="faq">
  <div class="container">
    <div class="section-header">
      <h2>Frequently Asked Questions</h2>
      <p>Common questions about {{ service | lower }} in {{ city }}, AL</p>
    </div>
    
    <div class="faq-list">
      {% for faq in faqs %}
      <div class="faq-item">
        <button class="faq-question">
          <span>{{ faq.question }}</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          {{ faq.answer | safe }}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# Related Services #}
<section class="related-services">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">Complete Your System</p>
      <h2>Related Services in {{ city }}</h2>
    </div>
    
    <div class="related-grid">
      {% if service_slug != "seamless-gutters" %}
      {% set link_path = "/services/" + city_slug + "/seamless-gutters/" %}
      <a href="{{ link_path | url }}" class="related-card">
        <h3>Seamless Gutters</h3>
        <p>Custom-fabricated gutters with no leak points.</p>
      </a>
      {% endif %}
      
      {% if service_slug != "gutter-guards" %}
      {% set link_path = "/services/" + city_slug + "/gutter-guards/" %}
      <a href="{{ link_path | url }}" class="related-card">
        <h3>Gutter Guards</h3>
        <p>Keep debris out and eliminate cleaning.</p>
      </a>
      {% endif %}
      
      {% if service_slug != "gutter-cleaning" %}
      {% set link_path = "/services/" + city_slug + "/gutter-cleaning/" %}
      <a href="{{ link_path | url }}" class="related-card">
        <h3>Gutter Cleaning</h3>
        <p>Professional cleaning inside and out.</p>
      </a>
      {% endif %}
      
      {% if service_slug != "downspouts" %}
      {% set link_path = "/services/" + city_slug + "/downspouts/" %}
      <a href="{{ link_path | url }}" class="related-card">
        <h3>Downspouts</h3>
        <p>Properly sized downspouts move water away.</p>
      </a>
      {% endif %}
      
      {% if service_slug != "underground-drains" %}
      {% set link_path = "/services/" + city_slug + "/underground-drains/" %}
      <a href="{{ link_path | url }}" class="related-card">
        <h3>Underground Drains</h3>
        <p>Route water far from your foundation.</p>
      </a>
      {% endif %}
      
      {% if service_slug != "rotten-wood-repair" %}
      {% set link_path = "/services/" + city_slug + "/rotten-wood-repair/" %}
      <a href="{{ link_path | url }}" class="related-card">
        <h3>Rotten Wood Repair</h3>
        <p>We repair damaged fascia before installing.</p>
      </a>
      {% endif %}
    </div>
  </div>
</section>

{# Final CTA #}
<section class="cta" id="contact">
  <div class="container">
    <h2>{{ cta_headline | default("Get a Free " + service + " Estimate in " + city) }}</h2>
    <p>{{ cta_subhead | default("Find out what professional " + service | lower + " will cost for your " + city + " home.") }}</p>
    <a href="https://BlueRiverGutters.as.me/" class="btn btn-primary">Schedule Free Estimate</a>
    <p class="cta-phone"><a href="tel:2566166760">📞 (256) 616-6760</a></p>
    <p class="cta-hours">MON-FRI 8:00AM-5:00PM</p>
  </div>
</section>
