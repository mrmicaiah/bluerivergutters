{# Footer #}
<footer class="footer">
  <div class="container">
    <div class="footer-grid-expanded">
      
      {# Brand Column #}
      <div class="footer-brand">
        <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/logo-white_w60npv.png" alt="Blue River Gutters" class="footer-logo">
        <p>North Alabama's trusted gutter experts since 2005. Professional installation, repair, and maintenance for homes and businesses.</p>
        <div class="social-links">
          <a href="https://www.facebook.com/bluerivergutters" target="_blank" rel="noopener" aria-label="Facebook">FB</a>
          <a href="https://www.instagram.com/bluerivergutter/" target="_blank" rel="noopener" aria-label="Instagram">IG</a>
          <a href="https://www.youtube.com/channel/UCzhtpjwziYvsTB_lHzmVT0w" target="_blank" rel="noopener" aria-label="YouTube">YT</a>
          <a href="https://www.pinterest.com/bluerivergutter/" target="_blank" rel="noopener" aria-label="Pinterest">PIN</a>
        </div>
      </div>
      
      {# Services Column #}
      <div class="footer-links">
        <h4>Services</h4>
        <ul>
          {% for service in nav.services %}
          <li><a href="{{ ('/services/' + service.slug + '/') | url }}">{{ service.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
      
      {# Resources Column #}
      <div class="footer-links">
        <h4>Resources</h4>
        <ul>
          <li><a href="{{ '/blog/' | url }}">Blog</a></li>
          <li><a href="{{ '/articles/' | url }}">Local Guides</a></li>
          <li><a href="{{ '/blog/gutter-cost-north-alabama-2026/' | url }}">Pricing Guide</a></li>
          <li><a href="{{ '/blog/seasonal-gutter-maintenance-guide-alabama/' | url }}">Maintenance Guide</a></li>
          <li><a href="{{ '/sitemap/' | url }}">Sitemap</a></li>
        </ul>
      </div>
      
      {# Primary Locations Column #}
      <div class="footer-links">
        <h4>Primary Markets</h4>
        <ul>
          {% for city in nav.locations.tier1 %}
          <li><a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">{{ city.name }}, AL</a></li>
          {% endfor %}
        </ul>
      </div>
      
      {# More Locations Column #}
      <div class="footer-links">
        <h4>More Locations</h4>
        <ul>
          {% for city in nav.locations.tier2 %}
          <li><a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">{{ city.name }}</a></li>
          {% endfor %}
          <li><a href="{{ '/locations/' | url }}" class="footer-view-all">All Locations →</a></li>
        </ul>
      </div>
      
      {# Contact Column #}
      <div class="footer-contact">
        <h4>Contact Us</h4>
        <ul>
          <li><a href="tel:2566166760">📞 (256) 616-6760</a></li>
          <li><a href="mailto:service@bluerivergutters.com">✉️ service@bluerivergutters.com</a></li>
          <li class="footer-address">📍 3315 Memorial Pkwy SW<br>Suite B13<br>Huntsville, AL 35801</li>
        </ul>
        <a href="https://BlueRiverGutters.as.me/" class="btn btn-secondary btn-small footer-cta">Schedule Free Estimate</a>
      </div>
      
    </div>
    
    {# Expanded Footer Locations - All Tiers #}
    <div class="footer-locations-expanded">
      <h4>Service Areas Across North Alabama</h4>
      <div class="footer-locations-grid">
        <div class="footer-locations-tier">
          <span class="tier-label">Huntsville Metro</span>
          <p>
            {% for city in nav.locations.tier1 %}
            <a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">{{ city.name }}</a>{% if not loop.last %} · {% endif %}
            {% endfor %}
          </p>
        </div>
        <div class="footer-locations-tier">
          <span class="tier-label">Regional Cities</span>
          <p>
            {% for city in nav.locations.tier2 %}
            <a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">{{ city.name }}</a>{% if not loop.last %} · {% endif %}
            {% endfor %}
          </p>
        </div>
        <div class="footer-locations-tier">
          <span class="tier-label">Communities We Serve</span>
          <p>
            {% for city in nav.locations.tier3 %}
            <a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">{{ city.name }}</a>{% if not loop.last %} · {% endif %}
            {% endfor %}
          </p>
        </div>
      </div>
    </div>
    
    {# Footer Bottom #}
    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} Blue River Gutters. All rights reserved.</p>
      <p class="footer-links-bottom">
        <a href="{{ '/' | url }}#about">About Us</a> · 
        <a href="{{ '/blog/' | url }}">Blog</a> ·
        <a href="{{ '/sitemap/' | url }}">Sitemap</a>
      </p>
    </div>
    
  </div>
</footer>

{# Sticky Mobile Footer #}
<div class="mobile-sticky-footer">
  <a href="tel:2566166760" class="mobile-sticky-btn" aria-label="Call us">
    <span>📞</span>
  </a>
  <a href="https://BlueRiverGutters.as.me/" class="mobile-sticky-btn" aria-label="Schedule estimate">
    <span>📋</span>
  </a>
</div>
