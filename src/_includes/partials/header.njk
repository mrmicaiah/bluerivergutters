{# Top Banner #}
<div class="top-banner">
  <a href="https://BlueRiverGutters.as.me/">✉️ Schedule Your Free Estimate Today</a>
</div>

{# Header #}
<header class="header">
  <div class="header-inner">
    <a href="{{ '/' | url }}" class="logo-link">
      <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/logo_fih2rm.webp" alt="Blue River Gutters" class="logo">
    </a>
    
    <nav class="nav" role="navigation" aria-label="Main navigation">
      <a href="{{ '/' | url }}">Home</a>
      
      {# Services Dropdown #}
      <div class="nav-dropdown">
        <button class="nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true">
          Services <span class="dropdown-arrow">▾</span>
        </button>
        <div class="nav-dropdown-menu">
          <a href="{{ '/services/' | url }}">All Services</a>
          <div class="dropdown-divider"></div>
          {% for service in nav.services %}
          <a href="{{ ('/services/' + service.slug + '/') | url }}">{{ service.name }}</a>
          {% endfor %}
        </div>
      </div>
      
      {# Locations Dropdown #}
      <div class="nav-dropdown">
        <button class="nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true">
          Locations <span class="dropdown-arrow">▾</span>
        </button>
        <div class="nav-dropdown-menu nav-dropdown-mega">
          <div class="mega-column">
            <span class="mega-heading">Primary Markets</span>
            {% for city in nav.locations.tier1 %}
            <a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">{{ city.name }}, AL</a>
            {% endfor %}
          </div>
          <div class="mega-column">
            <span class="mega-heading">More Locations</span>
            {% for city in nav.locations.tier2 %}
            <a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">{{ city.name }}</a>
            {% endfor %}
            <a href="{{ '/locations/' | url }}" class="view-all-link">View All Locations →</a>
          </div>
        </div>
      </div>
      
      <a href="{{ '/recent-projects/' | url }}">Projects</a>
      <a href="{{ '/blog/' | url }}">Blog</a>
      <a href="{{ '/' | url }}#about">About</a>
      <a href="tel:2566166760" class="nav-cta">📞 (256) 616-6760</a>
    </nav>
    
    <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

{# Mobile Nav #}
<nav class="mobile-nav" role="navigation" aria-label="Mobile navigation">
  <a href="{{ '/' | url }}">Home</a>
  
  {# Mobile Services Accordion #}
  <div class="mobile-accordion">
    <button class="mobile-accordion-toggle" aria-expanded="false">
      Services <span class="accordion-arrow">+</span>
    </button>
    <div class="mobile-accordion-content">
      <a href="{{ '/services/' | url }}">All Services</a>
      {% for service in nav.services %}
      <a href="{{ ('/services/' + service.slug + '/') | url }}">{{ service.name }}</a>
      {% endfor %}
    </div>
  </div>
  
  {# Mobile Locations Accordion #}
  <div class="mobile-accordion">
    <button class="mobile-accordion-toggle" aria-expanded="false">
      Locations <span class="accordion-arrow">+</span>
    </button>
    <div class="mobile-accordion-content">
      <span class="mobile-section-label">Primary Markets</span>
      {% for city in nav.locations.tier1 %}
      <a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">{{ city.name }}, AL</a>
      {% endfor %}
      <span class="mobile-section-label">More Locations</span>
      {% for city in nav.locations.tier2 %}
      <a href="{{ ('/gutters-' + city.slug + '-al/') | url }}">{{ city.name }}</a>
      {% endfor %}
      <a href="{{ '/locations/' | url }}" class="mobile-view-all">View All Locations →</a>
    </div>
  </div>
  
  <a href="{{ '/recent-projects/' | url }}">Projects</a>
  <a href="{{ '/blog/' | url }}">Blog</a>
  <a href="{{ '/' | url }}#about">About</a>
  <a href="tel:2566166760" class="mobile-nav-cta">📞 (256) 616-6760</a>
</nav>
