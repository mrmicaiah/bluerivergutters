{# Top Banner #}
<div class="top-banner">
  <a href="https://BlueRiverGutters.as.me/">✉️ Schedule Your Free Estimate</a>
</div>

{# Header #}
<header class="header">
  <div class="header-inner">
    <a href="{{ '/' | url }}" class="logo-link">
      <img src="https://res.cloudinary.com/dxzw1zwez/image/upload/logo_fih2rm.webp" alt="Blue River Gutters" class="logo">
    </a>
    
    <nav class="nav">
      <a href="{{ '/' | url }}">Home</a>
      
      {# Services Dropdown #}
      <div class="nav-dropdown">
        <a href="{{ '/services/' | url }}" class="nav-dropdown-trigger">
          Services <span class="dropdown-arrow">▾</span>
        </a>
        <div class="nav-dropdown-menu">
          {% for service in nav.services %}
          <a href="{{ '/services/' | url }}#{{ service.slug }}">{{ service.name }}</a>
          {% endfor %}
          <div class="dropdown-divider"></div>
          <a href="{{ '/services/' | url }}" class="dropdown-view-all">All Services →</a>
        </div>
      </div>
      
      {# Locations Dropdown #}
      <div class="nav-dropdown">
        <a href="{{ '/locations/' | url }}" class="nav-dropdown-trigger">
          Locations <span class="dropdown-arrow">▾</span>
        </a>
        <div class="nav-dropdown-menu nav-dropdown-locations">
          <div class="dropdown-section">
            <span class="dropdown-label">Primary Service Areas</span>
            {% for city in nav.locations.tier1 %}
            <a href="{{ '/locations/gutters-' + city.slug + '-al/' | url }}">{{ city.name }}</a>
            {% endfor %}
          </div>
          <div class="dropdown-divider"></div>
          <a href="{{ '/locations/' | url }}" class="dropdown-view-all">All 25+ Locations →</a>
        </div>
      </div>
      
      <a href="{{ '/blog/' | url }}">Blog</a>
      <a href="{{ '/' | url }}#about">About</a>
      <a href="{{ '/' | url }}#contact">Contact</a>
      <a href="tel:2566166760" class="nav-cta">📞 (256) 616-6760</a>
    </nav>
    
    <button class="mobile-menu-btn" aria-label="Open menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

{# Mobile Nav #}
<nav class="mobile-nav">
  <a href="{{ '/' | url }}">Home</a>
  
  <div class="mobile-nav-section">
    <a href="{{ '/services/' | url }}" class="mobile-nav-header">Services</a>
    <div class="mobile-nav-sub">
      {% for service in nav.services %}
      <a href="{{ '/services/' | url }}#{{ service.slug }}">{{ service.name }}</a>
      {% endfor %}
    </div>
  </div>
  
  <div class="mobile-nav-section">
    <a href="{{ '/locations/' | url }}" class="mobile-nav-header">Locations</a>
    <div class="mobile-nav-sub">
      {% for city in nav.locations.tier1 %}
      <a href="{{ '/locations/gutters-' + city.slug + '-al/' | url }}">{{ city.name }}</a>
      {% endfor %}
      <a href="{{ '/locations/' | url }}" class="mobile-nav-more">All Locations →</a>
    </div>
  </div>
  
  <a href="{{ '/blog/' | url }}">Blog</a>
  <a href="{{ '/' | url }}#about">About</a>
  <a href="{{ '/' | url }}#contact">Contact</a>
  <a href="tel:2566166760" class="mobile-nav-cta">📞 (256) 616-6760</a>
  <a href="https://BlueRiverGutters.as.me/" class="mobile-nav-cta mobile-nav-schedule">Schedule Estimate</a>
</nav>
