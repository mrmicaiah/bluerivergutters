---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {# Homepage #}
  <url>
    <loc>https://bluerivergutters.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  
  {# Main Pages #}
  <url>
    <loc>https://bluerivergutters.com/services/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://bluerivergutters.com/locations/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://bluerivergutters.com/blog/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://bluerivergutters.com/sitemap/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  
  {# Service Pages #}
  {% for service in nav.services %}
  <url>
    <loc>https://bluerivergutters.com/services/{{ service.slug }}/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  
  {# City Landing Pages - Tier 1 (Highest Priority) #}
  {% for city in nav.locations.tier1 %}
  <url>
    <loc>https://bluerivergutters.com/gutters-{{ city.slug }}-al/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  {% endfor %}
  
  {# City Landing Pages - Tier 2 #}
  {% for city in nav.locations.tier2 %}
  <url>
    <loc>https://bluerivergutters.com/gutters-{{ city.slug }}-al/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}
  
  {# City Landing Pages - Tier 3 #}
  {% for city in nav.locations.tier3 %}
  <url>
    <loc>https://bluerivergutters.com/gutters-{{ city.slug }}-al/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
  
  {# Service + City Pages - Tier 1 Cities #}
  {% for city in nav.locations.tier1 %}
  {% for service in nav.services %}
  <url>
    <loc>https://bluerivergutters.com/{{ service.slug }}-{{ city.slug }}-al/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}
  {% endfor %}
  
  {# Service + City Pages - Tier 2 Cities #}
  {% for city in nav.locations.tier2 %}
  {% for service in nav.services %}
  <url>
    <loc>https://bluerivergutters.com/{{ service.slug }}-{{ city.slug }}-al/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
  {% endfor %}
  
  {# Blog Posts - Generated from collection #}
  {% for post in collections.blog %}
  <url>
    <loc>https://bluerivergutters.com{{ post.url }}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
  {% endfor %}
  
</urlset>
