---
permalink: /live/post/
eleventyExcludeFromCollections: true
sitemap: false
---
{#- Blue River Live — the crew's posting page. Not linked from anywhere, not
    indexed, not in either sitemap, no analytics. Stands alone (no base.njk):
    it's an app screen, not a site page. Logic lives in /js/live-post.js; the
    posting link carries its token in the fragment (#t=...). -#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="no-referrer">
  <title>Post to Blue River Live</title>
  <link rel="manifest" href="{{ '/live/post/manifest.webmanifest' | url }}">
  <link rel="apple-touch-icon" href="{{ '/images/live/live-post-icon-180.png' | url }}">
  <link rel="icon" type="image/png" sizes="192x192" href="{{ '/images/live/live-post-icon-192.png' | url }}">
  <meta name="theme-color" content="#1e40af">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="BR Live">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <style>
    :root { --navy: #0f172a; --blue: #1e40af; --blue-light: #3b82f6; --red: #ef4444; --green: #16a34a; --gray: #64748b; --line: #e2e8f0; --bg: #f1f5f9; }
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--navy); -webkit-text-size-adjust: 100%; }
    [hidden] { display: none !important; }
    .lp-top { background: var(--blue); color: #fff; padding: calc(env(safe-area-inset-top) + 14px) 16px 14px; display: flex; align-items: center; gap: 10px; }
    .lp-top h1 { margin: 0; font-size: 1.15rem; font-weight: 800; letter-spacing: .02em; }
    .lp-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 0 rgba(239,68,68,.6); animation: lp-pulse 1.6s infinite; }
    @keyframes lp-pulse { 70% { box-shadow: 0 0 0 9px rgba(239,68,68,0); } 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); } }
    @media (prefers-reduced-motion: reduce) { .lp-dot { animation: none; } }
    main { max-width: 560px; margin: 0 auto; padding: 16px 16px calc(env(safe-area-inset-bottom) + 32px); }
    .lp-card { background: #fff; border-radius: 14px; padding: 16px; margin-bottom: 16px; box-shadow: 0 1px 2px rgba(15,23,42,.06); }
    .lp-pick { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 64px; border: 2px dashed var(--blue-light); border-radius: 12px; background: #eff6ff; color: var(--blue); font-size: 1.1rem; font-weight: 700; cursor: pointer; }
    .lp-pick input { position: absolute; width: 1px; height: 1px; opacity: 0; }
    .lp-rules { margin: 12px 0 0; font-size: .9rem; color: var(--gray); text-align: center; }
    .lp-cap-note { margin: 0 0 12px; padding: 10px 12px; border-radius: 10px; background: #fef3c7; color: #92400e; font-weight: 600; font-size: .9rem; }
    .lp-items { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 10px; }
    .lp-item { display: flex; gap: 12px; align-items: center; }
    .lp-item img { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; background: var(--line); flex: none; }
    .lp-item-meta { flex: 1; min-width: 0; display: grid; grid-template-columns: 1fr auto; gap: 4px 8px; font-size: .9rem; }
    .lp-item-when { color: var(--gray); }
    .lp-item-status { font-weight: 600; }
    .lp-item[data-state="done"] .lp-item-status { color: var(--green); }
    .lp-item[data-state="failed"] .lp-item-status { color: var(--red); }
    .lp-progress { grid-column: 1 / -1; width: 100%; height: 8px; appearance: none; -webkit-appearance: none; border: 0; border-radius: 4px; background: var(--line); overflow: hidden; }
    .lp-progress::-webkit-progress-bar { background: var(--line); border-radius: 4px; }
    .lp-progress::-webkit-progress-value { background: var(--blue-light); border-radius: 4px; transition: width .2s; }
    .lp-progress::-moz-progress-bar { background: var(--blue-light); }
    .lp-item[data-state="done"] .lp-progress::-webkit-progress-value { background: var(--green); }
    label.lp-label { display: block; font-weight: 700; margin: 0 0 6px; }
    .lp-town-row { display: flex; gap: 8px; }
    select, textarea { width: 100%; font: inherit; font-size: 16px; padding: 12px; border: 1px solid #cbd5e1; border-radius: 10px; background: #fff; color: var(--navy); }
    select { flex: 1; }
    .lp-locate { flex: none; font: inherit; font-size: .9rem; font-weight: 600; padding: 0 12px; border: 1px solid var(--blue-light); border-radius: 10px; background: #fff; color: var(--blue); }
    .lp-note { min-height: 1.2em; margin: 6px 0 14px; font-size: .85rem; color: var(--gray); }
    textarea { resize: vertical; min-height: 72px; margin-bottom: 14px; }
    .lp-post { width: 100%; min-height: 60px; border: 0; border-radius: 12px; background: var(--blue); color: #fff; font-size: 1.2rem; font-weight: 800; cursor: pointer; }
    .lp-post:disabled { background: #94a3b8; }
    .lp-busy .lp-post { background: var(--blue-light); }
    .lp-error { margin: 10px 0 0; color: var(--red); font-weight: 600; }
    .lp-success { text-align: center; }
    .lp-success p { font-size: 1.15rem; font-weight: 700; margin: 4px 0 14px; }
    .lp-check { font-size: 2.4rem; color: var(--green); line-height: 1; }
    .lp-again { font: inherit; font-weight: 700; padding: 12px 20px; border-radius: 10px; border: 2px solid var(--blue); background: #fff; color: var(--blue); }
    h2 { font-size: 1rem; margin: 0 0 10px; }
    .lp-recent { list-style: none; margin: 0; padding: 0; }
    .lp-entry { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 10px 0; border-top: 1px solid var(--line); }
    .lp-entry:first-child { border-top: 0; }
    .lp-cover { position: relative; flex: none; }
    .lp-cover img { display: block; width: 64px; height: 64px; object-fit: cover; border-radius: 8px; background: var(--line); }
    .lp-count { position: absolute; right: 4px; bottom: 4px; padding: 1px 6px; border-radius: 10px; background: rgba(15,23,42,.8); color: #fff; font-size: .75rem; font-weight: 700; }
    .lp-expand { flex: none; font: inherit; font-size: .85rem; font-weight: 600; padding: 8px 10px; border-radius: 8px; border: 1px solid #cbd5e1; background: #fff; color: var(--blue); }
    .lp-photos { flex-basis: 100%; list-style: none; margin: 0; padding: 0 0 0 74px; display: grid; gap: 8px; }
    .lp-photo { display: flex; align-items: center; gap: 10px; }
    .lp-photo img { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; background: var(--line); flex: none; margin-right: auto; }
    .lp-recent-meta { flex: 1; min-width: 0; display: grid; gap: 2px; font-size: .85rem; }
    .lp-recent-meta span { color: var(--gray); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .lp-remove, .lp-remove-confirm { flex: none; font: inherit; font-size: .85rem; font-weight: 600; padding: 8px 10px; border-radius: 8px; border: 1px solid #cbd5e1; background: #fff; color: var(--gray); }
    .lp-remove-confirm { border-color: var(--red); background: var(--red); color: #fff; }
    .lp-empty { color: var(--gray); font-size: .9rem; margin: 0; }
    .lp-invalid { text-align: center; padding: 32px 16px; }
    .lp-invalid p { margin: 8px 0; }
  </style>
</head>
<body>
  <header class="lp-top"><span class="lp-dot" aria-hidden="true"></span><h1>Blue River Live</h1></header>
  <main>
    <noscript><div class="lp-card">This page needs JavaScript turned on.</div></noscript>

    <div class="lp-card lp-invalid" id="lp-invalid" hidden>
      <p><strong>This posting link is not valid.</strong></p>
      <p>Ask Micaiah for a fresh link.</p>
    </div>

    <div id="lp-app" hidden>
      <div class="lp-card">
        <label class="lp-pick">
          <span aria-hidden="true">📷</span> Choose photos
          <input type="file" id="lp-files" accept="image/*" multiple>
        </label>
        <p class="lp-rules">No faces without an OK, no house numbers or plates.</p>
      </div>

      <div class="lp-card" id="lp-compose" hidden>
        <p class="lp-cap-note" id="lp-cap-note" role="status" hidden></p>
        <ul class="lp-items" id="lp-items"></ul>

        <label class="lp-label" for="lp-town">Town</label>
        <div class="lp-town-row">
          <select id="lp-town"><option value="">Pick the town…</option></select>
          <button type="button" class="lp-locate" id="lp-locate">Use my location</button>
        </div>
        <p class="lp-note" id="lp-town-note" aria-live="polite"></p>

        <label class="lp-label" for="lp-comment">Comment <span style="font-weight:400;color:var(--gray)">(optional, goes on every photo)</span></label>
        <textarea id="lp-comment" maxlength="280" placeholder="Seamless 6&quot; install, before &amp; after"></textarea>

        <button type="button" class="lp-post" id="lp-post" disabled>Post</button>
        <p class="lp-error" id="lp-error" role="alert" hidden></p>
      </div>

      <div class="lp-card lp-success" id="lp-success" hidden>
        <div class="lp-check" aria-hidden="true">✓</div>
        <p id="lp-success-text">Posted.</p>
        <button type="button" class="lp-again" id="lp-again">Post more</button>
      </div>

      <div class="lp-card">
        <h2>Recent posts</h2>
        <ul class="lp-recent" id="lp-recent"></ul>
        <p class="lp-empty" id="lp-recent-empty" hidden>Nothing posted yet.</p>
      </div>
    </div>
  </main>
  <script src="{{ '/js/service-area.js' | url }}"></script>
  <script src="{{ '/js/live-post.js' | url }}"></script>
</body>
</html>
