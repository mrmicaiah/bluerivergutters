{# Courier Form Handler — with honeypot bot protection #}
<script>
(function() {
  const CONFIG = {
    list: 'blue-river-gutters-leads',
    source: 'bluerivergutters.com',
    funnel: 'contact-form',
    formSelector: '#contact-form',
    customFields: ['phone', 'city', 'service', 'message'],
    redirectUrl: '/thank-you/'
  };

  const API_URL = 'https://email-bot-server.micaiah-tasks.workers.dev/api/subscribe';
  const FORM_LOAD_TIME = Date.now();

  document.querySelector(CONFIG.formSelector)?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target;

    // Honeypot check #1: hidden field must be empty
    const honeypot = form.querySelector('[name="website"]')?.value;
    if (honeypot) {
      console.warn('Honeypot triggered — silent reject');
      window.location.href = CONFIG.redirectUrl; // Show success to bot
      return;
    }

    // Honeypot check #2: form must take a human at least 3 seconds
    const elapsed = Date.now() - FORM_LOAD_TIME;
    if (elapsed < 3000) {
      console.warn('Form filled too fast (' + elapsed + 'ms) — silent reject');
      window.location.href = CONFIG.redirectUrl;
      return;
    }

    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn?.textContent;
    
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Sending...';
    }

    const payload = {
      email: form.querySelector('[name="email"]')?.value,
      list: CONFIG.list,
      source: CONFIG.source,
      funnel: CONFIG.funnel
    };

    const nameField = form.querySelector('[name="name"]');
    if (nameField?.value) payload.name = nameField.value;

    if (CONFIG.customFields.length > 0) {
      payload.metadata = { time_to_fill_ms: elapsed };
      CONFIG.customFields.forEach(field => {
        const el = form.querySelector(`[name="${field}"]`);
        if (el?.value) payload.metadata[field] = el.value;
      });
    }

    try {
      const resp = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await resp.json();

      if (resp.ok) {
        if (typeof gtag === 'function') {
          gtag('event', 'generate_lead', {
            event_category: 'engagement',
            event_label: 'contact_form',
            value: 1
          });
        }
        window.location.href = CONFIG.redirectUrl;
      } else {
        showMessage(form, data.error || 'Something went wrong. Please try again.', 'error');
      }
    } catch (err) {
      showMessage(form, 'Something went wrong. Please try again.', 'error');
    }

    if (btn) {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });

  function showMessage(form, text, type) {
    let msg = form.querySelector('.form-message');
    if (!msg) {
      msg = document.createElement('p');
      msg.className = 'form-message';
      form.appendChild(msg);
    }
    msg.textContent = text;
    msg.className = 'form-message ' + type;
  }
})();
</script>
