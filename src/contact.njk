{# Lead Form Handler (posts to /api/lead) — guards, zip allowlist and zip -> city come from
   /js/lead-form.js (window.BRGLeadGuards), fed by src/_data/serviceArea.js #}
<script src="{{ '/js/service-area.js' | url }}"></script>
<script src="{{ '/js/lead-form.js' | url }}"></script>
<script>
(function() {
  const CONFIG = {
    // v3 marks the shortened form (phone required, email and message optional, city
    // filled from zip). Earlier funnel values stay in Courier's history so the
    // dashboard can tell the eras apart.
    funnel: 'contact-form-v3',
    formSelector: '#contact-form',
    redirectUrl: '/thank-you/'
  };

  const G = window.BRGLeadGuards;
  const FORM_LOAD_TIME = Date.now();
  const form = document.querySelector(CONFIG.formSelector);
  if (!form || !G) return;

  const emailRequired = form.getAttribute('data-email-required') === 'true';
  G.bindZipCity(form.querySelector('[name="zip"]'), form.querySelector('[name="city"]'), form.querySelector('.zip-city'));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const field = (name) => form.querySelector(`[name="${name}"]`);
    const invalid = (text, name) => {
      showMessage(form, text, 'error');
      field(name)?.focus();
    };

    // Honeypot check #1: hidden field must be empty
    if (field('website')?.value) {
      console.warn('Honeypot triggered — silent reject');
      window.location.href = CONFIG.redirectUrl; // Show success to bot
      return;
    }

    // Honeypot check #2: form must take a human at least 3 seconds
    const elapsed = Date.now() - FORM_LOAD_TIME;
    if (elapsed < 3000) {
      console.warn('Form filled too fast (' + elapsed + 'ms) — silent reject');
      window.location.href = CONFIG.redirectUrl;
      return;
    }

    const name = field('name')?.value.trim() || '';
    const phone = field('phone')?.value.trim() || '';
    const zip = field('zip')?.value.trim() || '';
    const email = field('email')?.value.trim() || '';
    const messageText = field('message')?.value.trim() || '';

    if (!name) return invalid('Please tell us your name.', 'name');
    if (!G.isPhone(phone)) return invalid('Please enter a phone number we can reach you at.', 'phone');

    // Required 5-digit zip. Every genuine submission in the lead history that
    // was asked for a zip supplied one; none of the marketing spam ever did.
    if (!/^[0-9]{5}$/.test(zip)) return invalid('Please enter your 5-digit zip code so we know the area.', 'zip');

    if (emailRequired && !email) return invalid('Please enter your email address.', 'email');
    if (email && !G.isEmail(email)) return invalid('Please enter a valid email address.', 'email');

    // The message is optional, so its shape is only checked when one was typed.
    // Visible, never silent: a real customer who typed too little needs to be
    // told, not quietly dropped.
    if (messageText && !G.hasSubstantiveMessage(messageText)) {
      return invalid('Please tell us a bit more about the work you need — ' +
        'a full sentence helps us come prepared, or leave the message blank.', 'message');
    }

    // Outreach scan runs BEFORE the service-area check on purpose. Both would
    // stop a pitch, but only this one is silent — checking it first means a
    // spammer never sees the zip message and so never learns the zip rule.
    if (G.looksLikeOutreach(messageText)) {
      console.warn('Outreach markers matched — silent reject');
      window.location.href = CONFIG.redirectUrl; // Show success, same as honeypot
      return;
    }

    // Out of area gets a visible message, never a silent fail: a real customer
    // who fat-fingers their zip needs a way back in.
    if (!G.inServiceArea(zip)) {
      return invalid("Looks like you're outside our North Alabama service area. " +
        "If you think that's wrong, call us at (256) 616-6760", 'zip');
    }

    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn?.textContent;

    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Sending...';
    }

    const payload = {
      name: name,
      phone: phone,
      zip: zip,
      city: field('city')?.value || G.cityForZip(zip),
      email: email,
      message: messageText,
      service: field('service')?.value || '',
      source: 'bluerivergutters.com',
      funnel: CONFIG.funnel,
      time_to_fill_ms: elapsed
    };

    // Past every guard: honeypot, 3s timing floor, required name/phone/zip,
    // email rules, message shape (when given), outreach-marker scan,
    // service-area check. This is the genuine send — the only branch that
    // posts to /api/lead. Fired here, before the
    // /thank-you/ redirect below, because events queued after navigation
    // starts can be lost.
    window.brgTrack && window.brgTrack('form_submit_contact');

    try {
      const resp = await fetch(G.LEAD_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await resp.json().catch(() => ({}));

      if (resp.ok) {
        if (typeof gtag === 'function') {
          gtag('event', 'generate_lead', {
            event_category: 'engagement',
            event_label: 'contact_form',
            value: 1
          });
        }
        window.location.href = CONFIG.redirectUrl;
      } else {
        showMessage(form, data.error || 'Something went wrong. Please try again.', 'error');
      }
    } catch (err) {
      showMessage(form, 'Something went wrong. Please try again.', 'error');
    }

    if (btn) {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });

  function showMessage(form, text, type) {
    let msg = form.querySelector('.form-message');
    if (!msg) {
      msg = document.createElement('p');
      msg.className = 'form-message';
      form.appendChild(msg);
    }
    msg.textContent = text;
    msg.className = 'form-message ' + type;
  }
})();
</script>
